# -*- mode: ruby -*-
# vi: set ft=ruby :

# SigmaOS: The Industry-Leading Sovereign OS
# VirtualBox Deployment Specification

Vagrant.configure("2") do |config|
  config.vm.box = "debian/bookworm64"

  config.vm.provider "virtualbox" do |vb|
    vb.name = "SigmaOS_Sovereign_StandAlone"
    vb.memory = "2048"
    vb.cpus = 2
    vb.gui = true
    
    # Industry-Leading Hardware Acceleration
    vb.customize ["modifyvm", :id, "--graphicscontroller", "vmsvga"]
    vb.customize ["modifyvm", :id, "--vram", "128"]
    vb.customize ["modifyvm", :id, "--paravirtprovider", "kvm"]
  end

  config.vm.provision "shell", inline: <<-SHELL
    export DEBIAN_FRONTEND=noninteractive
    echo "Applying SigmaOS Sovereign Hardening..."
    
    # 1. Extreme Memory Compression (ZRAM)
    apt-get update -y
    apt-get install -y zram-tools ufw xfce4 xfce4-goodies
    echo "ALGO=zstd" >> /etc/default/zramswap
    echo "PERCENT=60" >> /etc/default/zramswap
    service zramswap restart

    # 2. Kernel Speed Tuning
    echo "vm.swappiness=5" >> /etc/sysctl.conf
    echo "vm.vfs_cache_pressure=40" >> /etc/sysctl.conf
    sysctl -p

    # 3. Security Hardening
    ufw default deny incoming
    ufw default allow outgoing
    ufw allow ssh
    ufw --force enable

    # 4. Windows-Style Desktop (Lightweight XFCE)
    # Optimized for Windows users to feel at home immediately
    
    echo "SigmaOS Standalone: Deployment Successful."
  SHELL
end
