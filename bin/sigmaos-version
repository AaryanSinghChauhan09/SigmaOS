#!/usr/bin/env bash
# sigmaos-version - Report SigmaOS version
# SigmaOS version report.

set -euo pipefail

REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_PATH")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
SIGMAOS_PATH="${SIGMAOS_PATH:-$ROOT_DIR}"

if [ -f "${SIGMAOS_PATH}/version" ]; then
  cat "${SIGMAOS_PATH}/version"
elif [ -f "${ROOT_DIR}/version" ]; then
  cat "${ROOT_DIR}/version"
elif [ -f "/usr/share/sigmaos/version" ]; then
  cat "/usr/share/sigmaos/version"
else
  echo "1.0.0-alpha.1"
fi
