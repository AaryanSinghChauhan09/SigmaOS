#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# sigmaos-quickshell — Quickshell & Waybar Desktop Shell Orchestrator
# Starts modern QML Quickshell bar if available; otherwise falls back to Waybar.
#
# Usage:
#   sigmaos-quickshell [start|stop|reload|status]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

CYAN='\033[0;36m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'
BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${CYAN}[shell]${RESET} $*"; }
success() { echo -e "${GREEN}[shell]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[shell]${RESET} $*"; }
err()     { echo -e "${RED}[shell]${RESET} $*" >&2; }

QML_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell"
if [ ! -d "$QML_DIR" ] && [ -d "$ROOT_DIR/config/omarchy/quickshell" ]; then
  QML_DIR="$ROOT_DIR/config/omarchy/quickshell"
fi

cmd="${1:-start}"

case "$cmd" in
  start)
    if command -v quickshell &>/dev/null && [ -f "$QML_DIR/shell.qml" ]; then
      info "Launching QML Quickshell desktop shell..."
      pkill -x quickshell 2>/dev/null || true
      quickshell -p "$QML_DIR" &
      disown
      success "Quickshell active"
    else
      info "Quickshell not found or config missing; launching Waybar status panel..."
      pkill -x waybar 2>/dev/null || true
      waybar &
      disown
      success "Waybar active"
    fi
    ;;

  stop)
    info "Stopping desktop shell panels..."
    pkill -x quickshell 2>/dev/null || true
    pkill -x waybar 2>/dev/null || true
    success "Desktop shell stopped"
    ;;

  reload)
    info "Reloading desktop shell..."
    if pgrep -x quickshell &>/dev/null; then
      pkill -x quickshell 2>/dev/null || true
      quickshell -p "$QML_DIR" & disown
    elif pgrep -x waybar &>/dev/null; then
      pkill -SIGUSR2 waybar 2>/dev/null || true
    fi
    success "Shell reloaded"
    ;;

  status)
    if pgrep -x quickshell &>/dev/null; then
      echo "Quickshell: RUNNING (PID: $(pgrep -x quickshell | head -1))"
    elif pgrep -x waybar &>/dev/null; then
      echo "Waybar: RUNNING (PID: $(pgrep -x waybar | head -1))"
    else
      echo "Desktop Shell: IDLE"
    fi
    ;;

  *)
    echo "Usage: sigmaos-quickshell [start|stop|reload|status]"
    exit 1
    ;;
esac
