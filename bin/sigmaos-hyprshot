#!/usr/bin/env bash
# SigmaOS Sovereign Desktop — Enhanced Screenshot Tool
# Full hyprshot integration: region/window/output + annotation (swappy) + clipboard
# Usage: sigmaos-hyprshot [--region|--window|--output|--full] [--annotate] [--clipboard] [--delay N]

set -euo pipefail

SCREENSHOTS_DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$SCREENSHOTS_DIR"

TIMESTAMP="$(date +%Y%m%d_%H%M%S)"
OUTPUT_FILE="$SCREENSHOTS_DIR/sigma_${TIMESTAMP}.png"
MODE="region"
ANNOTATE=false
CLIPBOARD=false
DELAY=0
SILENT=false

BOLD=$'\033[1m'
GREEN=$'\033[0;32m'
CYAN=$'\033[0;36m'
YELLOW=$'\033[1;33m'
RED=$'\033[0;31m'
RESET=$'\033[0m'

usage() {
  cat <<EOF
${BOLD}sigmaos-hyprshot${RESET} — Screenshot Tool

${BOLD}MODES${RESET}
  --region, -r         Interactive region selection (default)
  --window, -w         Capture focused window
  --output, -o         Capture entire monitor output
  --full, -f           Capture all outputs (panoramic)

${BOLD}OPTIONS${RESET}
  --annotate, -a       Open in swappy for annotation after capture
  --clipboard, -c      Copy to clipboard instead of (or in addition to) saving
  --delay <N>          Delay N seconds before capture
  --output-file <F>    Override output file path
  --silent, -s         No desktop notifications
  -h, --help           Show this help

${BOLD}EXAMPLES${RESET}
  sigmaos-hyprshot --region --annotate
  sigmaos-hyprshot --window --clipboard
  sigmaos-hyprshot --full --delay 3
EOF
}

notify_ok() {
  $SILENT && return
  if command -v notify-send &>/dev/null; then
    notify-send --icon=camera "SigmaOS Screenshot" "$1" --hint=string:x-canonical-snap-id:sigmaos-shot
  fi
}

notify_err() {
  $SILENT && return
  if command -v notify-send &>/dev/null; then
    notify-send --icon=camera-off --urgency=critical "SigmaOS Screenshot Error" "$1"
  fi
}

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --region|-r)        MODE="region"; shift ;;
    --window|-w)        MODE="window"; shift ;;
    --output|-o)        MODE="output"; shift ;;
    --full|-f)          MODE="full";   shift ;;
    --annotate|-a)      ANNOTATE=true; shift ;;
    --clipboard|-c)     CLIPBOARD=true; shift ;;
    --delay)            DELAY="${2:?}"; shift 2 ;;
    --output-file)      OUTPUT_FILE="${2:?}"; shift 2 ;;
    --silent|-s)        SILENT=true; shift ;;
    -h|--help)          usage; exit 0 ;;
    *)                  echo -e "${RED}Unknown option:${RESET} $1"; usage; exit 1 ;;
  esac
done

# Delay
if [[ $DELAY -gt 0 ]]; then
  echo -e "${CYAN}→ Capturing in ${DELAY}s...${RESET}"
  sleep "$DELAY"
fi

# Select capture backend
capture() {
  local mode="$1"

  # Try hyprshot first (native Hyprland)
  if command -v hyprshot &>/dev/null; then
    case "$mode" in
      region)  hyprshot -m region -o "$(dirname "$OUTPUT_FILE")" -f "$(basename "$OUTPUT_FILE")" --silent ;;
      window)  hyprshot -m window -o "$(dirname "$OUTPUT_FILE")" -f "$(basename "$OUTPUT_FILE")" --silent ;;
      output)  hyprshot -m output -o "$(dirname "$OUTPUT_FILE")" -f "$(basename "$OUTPUT_FILE")" --silent ;;
      full)    hyprshot -m output -o "$(dirname "$OUTPUT_FILE")" -f "$(basename "$OUTPUT_FILE")" --silent ;;
    esac
    return
  fi

  # Fallback: grim + slurp
  if command -v grim &>/dev/null; then
    case "$mode" in
      region)
        if command -v slurp &>/dev/null; then
          GEOM="$(slurp)" && grim -g "$GEOM" "$OUTPUT_FILE"
        else
          grim "$OUTPUT_FILE"
        fi
        ;;
      window)
        if command -v jq &>/dev/null && command -v hyprctl &>/dev/null; then
          GEOM="$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')"
          grim -g "$GEOM" "$OUTPUT_FILE"
        else
          grim "$OUTPUT_FILE"
        fi
        ;;
      output|full)
        grim "$OUTPUT_FILE"
        ;;
    esac
    return
  fi

  # Last resort: scrot
  if command -v scrot &>/dev/null; then
    case "$mode" in
      region)  scrot --select "$OUTPUT_FILE" ;;
      *)       scrot "$OUTPUT_FILE" ;;
    esac
    return
  fi

  echo -e "${RED}Error:${RESET} No screenshot tool found (need hyprshot, grim, or scrot)"
  notify_err "No screenshot tool available. Install hyprshot or grim+slurp."
  exit 1
}

# Capture
capture "$MODE"

# Verify file was created
if [[ ! -f "$OUTPUT_FILE" ]]; then
  echo -e "${RED}Error:${RESET} Screenshot not saved (capture cancelled or failed)"
  exit 1
fi

echo -e "${GREEN}✓ Screenshot saved:${RESET} $OUTPUT_FILE"

# Clipboard copy
if $CLIPBOARD; then
  if command -v wl-copy &>/dev/null; then
    wl-copy < "$OUTPUT_FILE"
    echo -e "${GREEN}✓ Copied to clipboard${RESET}"
  elif command -v xclip &>/dev/null; then
    xclip -selection clipboard -t image/png -i "$OUTPUT_FILE"
    echo -e "${GREEN}✓ Copied to clipboard (xclip)${RESET}"
  else
    echo -e "${YELLOW}⚠  wl-copy not found, clipboard copy skipped${RESET}"
  fi
fi

# Annotation
if $ANNOTATE; then
  if command -v swappy &>/dev/null; then
    echo -e "${CYAN}→ Opening in swappy for annotation...${RESET}"
    swappy -f "$OUTPUT_FILE" -o "$OUTPUT_FILE"
    echo -e "${GREEN}✓ Annotation saved${RESET}"
  else
    echo -e "${YELLOW}⚠  swappy not found, skipping annotation${RESET}"
  fi
fi

notify_ok "Saved: $(basename "$OUTPUT_FILE")"
