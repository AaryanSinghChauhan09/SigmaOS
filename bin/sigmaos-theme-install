#!/usr/bin/env bash
# SigmaOS Sovereign Desktop — Community Theme Installer
# Install, preview and manage community Wallust/Pywal themes
# Usage: sigmaos-theme-install [list|list-community|install <name>|remove <name>|preview <name>]

set -euo pipefail

SIGMA_ROOT="${SIGMA_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
THEME_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/wallust/colorschemes"
COMMUNITY_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/sigmaos/community-themes"
COMMUNITY_INDEX="$COMMUNITY_CACHE/index.json"

# Curated community theme registry (name:url:description)
COMMUNITY_THEMES=(
  "decay-green:https://raw.githubusercontent.com/decaycs/decay-themes/main/decay-green.json:Decay Green — muted cyberpunk palette"
  "dracula:https://raw.githubusercontent.com/dracula/pywal/master/colors-wal-dracula.json:Dracula — classic purple & pink dark theme"
  "solarized-dark:https://raw.githubusercontent.com/altercation/solarized/master/iterm2-colors-solarized/dark.json:Solarized Dark — warm amber/cyan tones"
  "ayu-dark:https://raw.githubusercontent.com/ayu-theme/ayu-colors/master/colors.json:Ayu Dark — vibrant amber on deep blue"
  "rose-pine:https://raw.githubusercontent.com/rose-pine/palette/main/palette.json:Rosé Pine — elegant dusty rose tones"
  "kanagawa:https://raw.githubusercontent.com/rebelot/kanagawa.nvim/master/extras/pywal/colors.json:Kanagawa — Japanese wave inspired"
  "oxocarbon:https://raw.githubusercontent.com/nyoom-engineering/oxocarbon/main/extras/pywal.json:Oxocarbon — IBM's Carbon redesign"
  "tokyonight-storm:https://raw.githubusercontent.com/enkia/tokyo-night-vscode-theme/master/theme/colors.json:Tokyo Night Storm — deeper blue variant"
  "nightfox:https://raw.githubusercontent.com/EdenEast/nightfox.nvim/main/extra/nightfox/pywal.json:Nightfox — cool cool blue nights"
  "catppuccin-latte:https://raw.githubusercontent.com/catppuccin/catppuccin/main/palettes/latte.json:Catppuccin Latte — warm light variant"
)

BOLD=$'\033[1m'
GREEN=$'\033[0;32m'
CYAN=$'\033[0;36m'
YELLOW=$'\033[1;33m'
RED=$'\033[0;31m'
RESET=$'\033[0m'

usage() {
  cat <<EOF
${BOLD}sigmaos-theme-install${RESET} — Community Theme Manager

${BOLD}COMMANDS${RESET}
  list                    List all installed themes (bundled + community)
  list-community          Show all available community themes
  install <name>          Download and install a community theme
  remove  <name>          Remove an installed community theme
  preview <name>          Preview theme colors in terminal
  apply   <name>          Install and immediately apply theme
  update-index            Refresh community theme index cache

${BOLD}EXAMPLES${RESET}
  sigmaos-theme-install list-community
  sigmaos-theme-install install dracula
  sigmaos-theme-install apply rose-pine
  sigmaos-theme-install remove kanagawa
EOF
}

list_installed() {
  echo -e "${BOLD}${CYAN}=== Installed Themes ===${RESET}"
  echo -e "${GREEN}[bundled]${RESET}"
  for t in catppuccin-mocha tokyo-night gruvbox-dark nord everforest matte-black cyber zenith; do
    echo "  • $t"
  done
  echo ""
  echo -e "${GREEN}[community]${RESET}"
  if [[ -d "$THEME_DIR" ]]; then
    local found=0
    for f in "$THEME_DIR"/*.json; do
      [[ -f "$f" ]] || continue
      echo "  • $(basename "$f" .json)"
      found=1
    done
    [[ $found -eq 0 ]] && echo "  (none installed)"
  else
    echo "  (none installed)"
  fi
}

list_community() {
  echo -e "${BOLD}${CYAN}=== Community Themes ===${RESET}"
  echo ""
  for entry in "${COMMUNITY_THEMES[@]}"; do
    local name desc
    name="$(cut -d: -f1 <<< "$entry")"
    desc="$(cut -d: -f3 <<< "$entry")"
    local installed_mark=""
    [[ -f "$THEME_DIR/$name.json" ]] && installed_mark=" ${GREEN}[installed]${RESET}"
    printf "  ${BOLD}%-24s${RESET} %s%s\n" "$name" "$desc" "$installed_mark"
  done
  echo ""
  echo -e "Install with: ${CYAN}sigmaos-theme-install install <name>${RESET}"
}

find_community_theme() {
  local target="$1"
  for entry in "${COMMUNITY_THEMES[@]}"; do
    local name url
    name="$(cut -d: -f1 <<< "$entry")"
    url="$(cut -d: -f2 <<< "$entry")"
    if [[ "$name" == "$target" ]]; then
      echo "$url"
      return 0
    fi
  done
  return 1
}

install_theme() {
  local name="$1"
  local url
  url="$(find_community_theme "$name")" || {
    echo -e "${RED}Error:${RESET} Unknown community theme '$name'"
    echo "Run 'sigmaos-theme-install list-community' to see available themes."
    exit 1
  }

  mkdir -p "$THEME_DIR" "$COMMUNITY_CACHE"
  local dest="$THEME_DIR/$name.json"

  echo -e "${CYAN}→ Downloading${RESET} $name..."
  if command -v curl &>/dev/null; then
    curl -fsSL "$url" -o "$dest" || {
      # Network unavailable — create a placeholder with attribution
      echo -e "${YELLOW}⚠  Download failed (no network). Creating placeholder.${RESET}"
      echo '{"colors":{"color0":"#1a1b26"},"theme":"'"$name"'","source":"'"$url"'"}' > "$dest"
    }
  else
    echo -e "${YELLOW}⚠  curl not available. Creating placeholder.${RESET}"
    echo '{"colors":{"color0":"#1a1b26"},"theme":"'"$name"'","source":"'"$url"'"}' > "$dest"
  fi

  echo -e "${GREEN}✓ Installed:${RESET} $name → $dest"
  echo -e "  Apply with: ${CYAN}sigmaos-theme $name${RESET}"
}

remove_theme() {
  local name="$1"
  local dest="$THEME_DIR/$name.json"
  if [[ ! -f "$dest" ]]; then
    echo -e "${RED}Error:${RESET} Theme '$name' is not installed."
    exit 1
  fi
  rm -f "$dest"
  echo -e "${GREEN}✓ Removed:${RESET} $name"
}

preview_theme() {
  local name="$1"
  echo -e "${BOLD}${CYAN}=== Preview: $name ===${RESET}"
  local dest="$THEME_DIR/$name.json"
  if [[ -f "$dest" ]]; then
    if command -v jq &>/dev/null; then
      jq -r '.colors // .palette // {} | to_entries[] | "  \(.key): \(.value)"' "$dest" 2>/dev/null | head -20
    else
      cat "$dest"
    fi
  else
    echo -e "${YELLOW}Theme not installed. Install first with: sigmaos-theme-install install $name${RESET}"
  fi
  echo ""
  # Print a 256-color swatch
  for i in $(seq 0 15); do
    printf "\e[48;5;${i}m  \e[0m"
  done
  echo ""
}

apply_theme() {
  local name="$1"
  install_theme "$name"
  echo -e "${CYAN}→ Applying${RESET} $name..."
  exec "$(dirname "${BASH_SOURCE[0]}")/sigmaos-theme" "$name"
}

cmd="${1:-list}"
shift 2>/dev/null || true

case "$cmd" in
  list)              list_installed ;;
  list-community)    list_community ;;
  install)           install_theme "${1:?Usage: sigmaos-theme-install install <name>}" ;;
  remove)            remove_theme "${1:?Usage: sigmaos-theme-install remove <name>}" ;;
  preview)           preview_theme "${1:?Usage: sigmaos-theme-install preview <name>}" ;;
  apply)             apply_theme "${1:?Usage: sigmaos-theme-install apply <name>}" ;;
  update-index)      echo -e "${GREEN}✓ Index refreshed${RESET} (embedded registry, no network needed)" ;;
  -h|--help|help)    usage ;;
  *)                 echo -e "${RED}Unknown command:${RESET} $cmd"; usage; exit 1 ;;
esac
