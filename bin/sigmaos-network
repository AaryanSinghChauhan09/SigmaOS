#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# sigmaos-network — SigmaOS network manager frontend
# Wraps NetworkManager nmcli with friendly, discoverable UX.
#
# Usage: sigmaos-network <command> [args...]

set -euo pipefail

CYAN='\033[0;36m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'
BOLD='\033[1m'; RESET='\033[0m'
info()    { echo -e "${CYAN}[network]${RESET} $*"; }
success() { echo -e "${GREEN}[network]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[network]${RESET} $*"; }
err()     { echo -e "${RED}[network]${RESET} $*" >&2; }

usage() {
  cat <<'EOF'
sigmaos-network — SigmaOS Network Manager

USAGE
  sigmaos-network status            Show connection status and IP addresses
  sigmaos-network wifi list         Scan and list nearby WiFi networks
  sigmaos-network wifi connect <SSID> [password]
  sigmaos-network wifi disconnect
  sigmaos-network wifi off          Disable WiFi radio
  sigmaos-network wifi on           Enable WiFi radio
  sigmaos-network ethernet status   Show ethernet connection status
  sigmaos-network vpn list          List configured VPN connections
  sigmaos-network vpn connect <name>
  sigmaos-network vpn disconnect
  sigmaos-network dns set <server>  Set custom DNS (e.g. 1.1.1.1)
  sigmaos-network dns reset         Reset DNS to DHCP-provided
  sigmaos-network speed             Test download/upload speed (via speedtest-cli)
  sigmaos-network open              Open nm-connection-editor GUI
EOF
}

need_nmcli() {
  if ! command -v nmcli &>/dev/null; then
    err "nmcli not found. Install: pacman -S networkmanager && systemctl enable --now NetworkManager"
    exit 1
  fi
}

cmd="${1:-status}"
shift 2>/dev/null || true

case "$cmd" in
  status)
    need_nmcli
    echo -e "\n${BOLD}${CYAN}  Network Status${RESET}\n"
    nmcli -c yes general status
    echo ""
    nmcli -c yes device status
    echo ""
    # Show IPs
    for iface in $(ip -o link show | awk -F': ' '{print $2}' | grep -v lo); do
      local_ip=$(ip -4 addr show "$iface" 2>/dev/null | awk '/inet /{print $2}' | head -1)
      [ -n "$local_ip" ] && echo -e "  ${GREEN}$iface${RESET}  $local_ip"
    done
    echo ""
    ;;

  wifi)
    need_nmcli
    subcmd="${1:-list}"
    shift 2>/dev/null || true
    case "$subcmd" in
      list|scan)
        info "Scanning for WiFi networks..."
        nmcli -c yes device wifi list --rescan yes
        ;;
      connect)
        SSID="${1:-}"
        PASS="${2:-}"
        [ -z "$SSID" ] && { err "Usage: sigmaos-network wifi connect <SSID> [password]"; exit 1; }
        if [ -n "$PASS" ]; then
          info "Connecting to: $SSID"
          nmcli device wifi connect "$SSID" password "$PASS"
        else
          info "Connecting to: $SSID (no password / saved profile)"
          nmcli device wifi connect "$SSID"
        fi
        success "Connected to $SSID"
        ;;
      disconnect)
        info "Disconnecting WiFi..."
        nmcli device disconnect "$(nmcli -t -f DEVICE,TYPE device | grep wifi | cut -d: -f1 | head -1)"
        success "WiFi disconnected"
        ;;
      off)
        nmcli radio wifi off && success "WiFi radio disabled"
        ;;
      on)
        nmcli radio wifi on && success "WiFi radio enabled"
        ;;
      *)
        err "Unknown wifi subcommand: $subcmd"; usage; exit 1
        ;;
    esac
    ;;

  ethernet)
    need_nmcli
    info "Ethernet status:"
    nmcli -c yes device show "$(nmcli -t -f DEVICE,TYPE device | grep ethernet | cut -d: -f1 | head -1)" 2>/dev/null || warn "No ethernet device found"
    ;;

  vpn)
    need_nmcli
    subcmd="${1:-list}"
    shift 2>/dev/null || true
    case "$subcmd" in
      list)
        info "VPN connections:"
        nmcli connection show --active | grep vpn || warn "No active VPN"
        nmcli connection show | grep vpn || warn "No VPN profiles configured"
        ;;
      connect)
        [ -z "${1:-}" ] && { err "Usage: sigmaos-network vpn connect <name>"; exit 1; }
        nmcli connection up "$1" && success "VPN connected: $1"
        ;;
      disconnect)
        nmcli connection down "$(nmcli -t -f NAME,TYPE connection | grep vpn | cut -d: -f1 | head -1)" && success "VPN disconnected"
        ;;
    esac
    ;;

  dns)
    need_nmcli
    subcmd="${1:-}"
    shift 2>/dev/null || true
    case "$subcmd" in
      set)
        SERVER="${1:-1.1.1.1}"
        CONN=$(nmcli -t -f NAME connection show --active | head -1)
        info "Setting DNS to $SERVER for connection: $CONN"
        nmcli connection modify "$CONN" ipv4.dns "$SERVER"
        nmcli connection modify "$CONN" ipv4.ignore-auto-dns yes
        nmcli connection up "$CONN"
        success "DNS set to $SERVER"
        ;;
      reset)
        CONN=$(nmcli -t -f NAME connection show --active | head -1)
        info "Resetting DNS to DHCP for: $CONN"
        nmcli connection modify "$CONN" ipv4.dns ""
        nmcli connection modify "$CONN" ipv4.ignore-auto-dns no
        nmcli connection up "$CONN"
        success "DNS reset to DHCP"
        ;;
      *)
        err "Usage: sigmaos-network dns [set <server>|reset]"
        ;;
    esac
    ;;

  speed)
    if command -v speedtest-cli &>/dev/null; then
      info "Running speed test..."
      speedtest-cli
    elif command -v fast &>/dev/null; then
      fast
    elif command -v curl &>/dev/null; then
      info "Measuring download speed from fast.com..."
      curl -s https://raw.githubusercontent.com/sivel/speedtest-cli/master/speedtest.py | python3 - --simple
    else
      err "No speed test tool found. Install: pacman -S speedtest-cli"
    fi
    ;;

  open|gui)
    if command -v nm-connection-editor &>/dev/null; then
      nm-connection-editor &
      disown
    else
      err "nm-connection-editor not found. Install: pacman -S nm-connection-editor"
    fi
    ;;

  -h|--help|help) usage ;;
  *) err "Unknown command: $cmd"; usage; exit 1 ;;
esac
