#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# sigmaos-bluetooth — SigmaOS Bluetooth Manager CLI
# Ergonomic frontend for BlueZ bluetoothctl.
#
# Usage:
#   sigmaos-bluetooth status
#   sigmaos-bluetooth on
#   sigmaos-bluetooth off
#   sigmaos-bluetooth scan
#   sigmaos-bluetooth devices
#   sigmaos-bluetooth pair <MAC>
#   sigmaos-bluetooth connect <MAC>
#   sigmaos-bluetooth disconnect [MAC]
#   sigmaos-bluetooth remove <MAC>

set -euo pipefail

CYAN='\033[0;36m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'
BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${CYAN}[bluetooth]${RESET} $*"; }
success() { echo -e "${GREEN}[bluetooth]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[bluetooth]${RESET} $*"; }
err()     { echo -e "${RED}[bluetooth]${RESET} $*" >&2; }

usage() {
  cat <<'EOF'
sigmaos-bluetooth — SigmaOS Bluetooth Device Manager

USAGE
  sigmaos-bluetooth status            Show Bluetooth controller power & pairing status
  sigmaos-bluetooth on                Power on Bluetooth controller
  sigmaos-bluetooth off               Power off Bluetooth controller
  sigmaos-bluetooth scan              Scan for nearby discoverable devices (15s timeout)
  sigmaos-bluetooth devices           List paired and trusted devices
  sigmaos-bluetooth pair <MAC>        Pair with device
  sigmaos-bluetooth connect <MAC>     Connect to paired device (headphones, keyboards, etc.)
  sigmaos-bluetooth disconnect [MAC]  Disconnect active device
  sigmaos-bluetooth remove <MAC>      Untrust and remove device
EOF
}

need_bluetoothctl() {
  if ! command -v bluetoothctl &>/dev/null; then
    err "bluetoothctl not found. Ensure bluez and bluez-utils are installed."
    exit 1
  fi
}

cmd="${1:-status}"
shift 2>/dev/null || true

case "$cmd" in
  status)
    need_bluetoothctl
    echo -e "\n${BOLD}${CYAN}  SigmaOS Bluetooth Status${RESET}\n"
    bluetoothctl show 2>/dev/null | grep -E "Name|Powered|Discoverable|Pairable" || warn "Bluetooth controller unavailable or powered off."
    echo ""
    info "Connected devices:"
    bluetoothctl devices Connected 2>/dev/null || echo "None"
    echo ""
    ;;

  on)
    need_bluetoothctl
    bluetoothctl power on
    success "Bluetooth powered on"
    ;;

  off)
    need_bluetoothctl
    bluetoothctl power off
    success "Bluetooth powered off"
    ;;

  scan)
    need_bluetoothctl
    info "Scanning for nearby devices (Ctrl+C to stop)..."
    bluetoothctl --timeout 15 scan on || true
    echo ""
    info "Discovered devices:"
    bluetoothctl devices 2>/dev/null | head -20 || true
    ;;

  devices|list)
    need_bluetoothctl
    info "Paired devices:"
    bluetoothctl devices Paired 2>/dev/null || echo "No paired devices"
    ;;

  pair)
    need_bluetoothctl
    mac="${1:-}"
    [[ -z "$mac" ]] && { err "Device MAC address required. Usage: sigmaos-bluetooth pair <MAC>"; exit 1; }
    info "Pairing with $mac..."
    bluetoothctl pair "$mac"
    bluetoothctl trust "$mac"
    success "Paired and trusted $mac"
    ;;

  connect)
    need_bluetoothctl
    mac="${1:-}"
    [[ -z "$mac" ]] && { err "Device MAC address required. Usage: sigmaos-bluetooth connect <MAC>"; exit 1; }
    info "Connecting to $mac..."
    bluetoothctl connect "$mac"
    success "Connected to $mac"
    ;;

  disconnect)
    need_bluetoothctl
    mac="${1:-}"
    if [[ -n "$mac" ]]; then
      bluetoothctl disconnect "$mac"
    else
      bluetoothctl disconnect
    fi
    success "Disconnected"
    ;;

  remove)
    need_bluetoothctl
    mac="${1:-}"
    [[ -z "$mac" ]] && { err "Device MAC address required. Usage: sigmaos-bluetooth remove <MAC>"; exit 1; }
    bluetoothctl remove "$mac"
    success "Device $mac removed"
    ;;

  -h|--help|help)
    usage
    ;;

  *)
    err "Unknown command: $cmd"
    usage
    exit 1
    ;;
esac
