#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# sigmaos-installer-tui — Interactive Guided Installation Wizard for SigmaOS
# Provides a menu-driven terminal UI (Whiptail/Dialog/ANSI fallback) for live media installations.
# Employs strict defensive safety: active root drive protection, lockfile, and dry-run preview.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'
BOLD='\033[1m'; RESET='\033[0m'

TITLE="SigmaOS Sovereign Desktop Installer"

# Check for Whiptail or Dialog
HAS_DIALOG=0
if command -v whiptail &>/dev/null; then
  HAS_DIALOG=1
  UI="whiptail"
elif command -v dialog &>/dev/null; then
  HAS_DIALOG=1
  UI="dialog"
fi

msgbox() {
  local text="$1"
  if [ "$HAS_DIALOG" -eq 1 ]; then
    "$UI" --title "$TITLE" --msgbox "$text" 12 70
  else
    echo -e "\n${BOLD}${CYAN}=== $TITLE ===${RESET}\n$text\n"
    read -r -p "Press Enter to continue..."
  fi
}

yesno() {
  local text="$1"
  if [ "$HAS_DIALOG" -eq 1 ]; then
    "$UI" --title "$TITLE" --yesno "$text" 12 70
    return $?
  else
    echo -e "\n${BOLD}${YELLOW}$text [y/N]${RESET}"
    read -r answer
    [[ "${answer,,}" == "y" ]] && return 0 || return 1
  fi
}

inputbox() {
  local prompt="$1"
  local default="$2"
  if [ "$HAS_DIALOG" -eq 1 ]; then
    "$UI" --title "$TITLE" --inputbox "$prompt" 10 60 "$default" 3>&1 1>&2 2>&3
  else
    echo -en "${BOLD}$prompt [$default]: ${RESET}"
    read -r answer
    echo "${answer:-$default}"
  fi
}

main_wizard() {
  msgbox "Welcome to the SigmaOS Sovereign Desktop Installation Wizard.\n\nThis installer will guide you through partitioning, formatting, base package deployment, and Wayland session setup.\n\nSafety Guarantee: All configurations can be safely previewed in DRY-RUN mode."

  # 1. Disk Detection & Selection
  local devices=()
  while IFS= read -r line; do
    [ -n "$line" ] && devices+=("$line")
  done < <(lsblk -dpno NAME,SIZE,MODEL 2>/dev/null | grep -v "loop" | grep -v "airootfs" || true)

  if [ ${#devices[@]} -eq 0 ]; then
    msgbox "Error: No suitable storage block devices found."
    exit 1
  fi

  echo -e "\n${BOLD}${CYAN}Available Storage Devices:${RESET}\n"
  for i in "${!devices[@]}"; do
    echo "  [$i] ${devices[$i]}"
  done
  echo ""
  local disk_idx
  disk_idx=$(inputbox "Select target device index (e.g. 0)" "0")
  local selected_line="${devices[$disk_idx]}"
  local target_disk
  target_disk=$(echo "$selected_line" | awk '{print $1}')

  # Active host root protection check
  local active_root
  active_root=$(findmnt -no SOURCE / 2>/dev/null || true)
  if [ -n "$active_root" ]; then
    local active_disk
    active_disk=$(lsblk -no PKNAME "$active_root" 2>/dev/null || true)
    if [ -n "$active_disk" ] && [[ "$target_disk" =~ "$active_disk" ]]; then
      msgbox "CRITICAL ERROR: Target $target_disk is the active running host drive!\nRefusing to partition active system."
      exit 1
    fi
  fi

  # 2. Filesystem choice
  local fs_choice
  fs_choice=$(inputbox "Root Filesystem (Btrfs or Ext4)" "Btrfs")

  # 3. Disk Encryption (LUKS2)
  local luks_choice="disabled"
  if yesno "Enable Full Disk Encryption with LUKS2?\n\nProtects root partition at rest with passphrase security."; then
    luks_choice="enabled"
  fi

  # 4. Hostname and User
  local hostname
  hostname=$(inputbox "System Hostname" "sigmaos")
  local username
  username=$(inputbox "Primary Username" "sigma")

  # 5. Profile
  local profile
  profile=$(inputbox "Desktop Profile (Desktop or Minimal)" "Desktop")

  # 6. Summary & Mode Selection
  local summary="Target Disk:  $target_disk\nFilesystem:   $fs_choice\nLUKS2 Crypt:  $luks_choice\nHostname:     $hostname\nUsername:     $username\nProfile:      $profile"
  
  local luks_flag=""
  if [[ "$luks_choice" == "enabled" ]]; then
    luks_flag="--luks"
  fi

  if yesno "Review Installation Parameters:\n\n$summary\n\nRun in safe DRY-RUN simulation mode?"; then
    echo -e "\n${BOLD}${GREEN}==> Launching installer in DRY-RUN simulation mode...${RESET}\n"
    bash "$ROOT_DIR/bin/sigmaos-install" -a --dry-run -f "$fs_choice" -n "$hostname" $luks_flag "$target_disk"
  else
    if yesno "WARNING: Destructive mode will format $target_disk.\nAll data on this disk will be permanently destroyed.\n\nAre you absolutely sure?"; then
      echo -e "\n${BOLD}${RED}==> Launching destructive installation on $target_disk...${RESET}\n"
      sudo bash "$ROOT_DIR/bin/sigmaos-install" -a --destructive --confirm-disk "$target_disk" -f "$fs_choice" -n "$hostname" $luks_flag "$target_disk"
    else
      echo "Installation cancelled."
    fi
  fi
}

main_wizard "$@"
