#!/usr/bin/env bash
# sigmaos-theme-system - SigmaOS theme applier
# Applies theme templates from default/themed/ to user config locations.
# SigmaOS desktop theme applicator.

set -euo pipefail

REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_PATH")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
SIGMAOS_PATH="${SIGMAOS_PATH:-$ROOT_DIR}"

THEME_NAME="${1:-sigmaos}"
THEME_DIR=""

if [ -d "${SIGMAOS_PATH}/themes/${THEME_NAME}" ]; then
  THEME_DIR="${SIGMAOS_PATH}/themes/${THEME_NAME}"
elif [ -d "${ROOT_DIR}/default/themed" ]; then
  THEME_DIR="${ROOT_DIR}/default/themed"
elif [ -d "/usr/share/sigmaos/themes/${THEME_NAME}" ]; then
  THEME_DIR="/usr/share/sigmaos/themes/${THEME_NAME}"
fi

apply_template() {
  local template="$1"
  local target="$2"
  if [ -n "${THEME_DIR}" ] && [ -f "${THEME_DIR}/${template}" ]; then
    mkdir -p "$(dirname "${target}")"
    cp "${THEME_DIR}/${template}" "${target}"
    echo "[sigmaos-theme-system] Applied ${template} -> ${target}"
  fi
}

if [ -n "${THEME_DIR}" ]; then
  apply_template "foot.ini.tpl" "${HOME}/.config/foot/foot.ini"
  apply_template "ghostty.conf.tpl" "${HOME}/.config/ghostty/config"
  apply_template "hyprland.lua.tpl" "${HOME}/.config/hypr/hyprland.conf"
  apply_template "btop.theme.tpl" "${HOME}/.config/btop/btop.theme"
  echo "[sigmaos-theme-system] Theme ${THEME_NAME} applied successfully from ${THEME_DIR}"
else
  echo "[sigmaos-theme-system] Theme directory for ${THEME_NAME} not found" >&2
  exit 1
fi
