#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# sigmaos-install - SigmaOS Sovereign System Installer
# Defensive entry point for host-side and live media installations.
# Defaults to DRY_RUN=1. Destructive operations strictly require:
#   --destructive AND --confirm-disk <TARGET_DEV>
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

# If the full industrial installer exists at iso_root/installer/install.sh, delegate to it
if [[ -f "$ROOT_DIR/iso_root/installer/install.sh" ]]; then
    exec bash "$ROOT_DIR/iso_root/installer/install.sh" "$@"
fi

# Fallback: if running installed in /usr/local/bin or /usr/bin
if [[ -f "/usr/local/bin/sigmaos-install" && "$SCRIPT_DIR" != "/usr/local/bin" ]]; then
    exec bash "/usr/local/bin/sigmaos-install" "$@"
fi

# Standalone defensive execution
DRY_RUN=1
DESTRUCTIVE_AUTH=0
CONFIRM_DISK_MATCH=""
TARGET_DEV=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--dry-run)
            DRY_RUN=1
            shift
            ;;
        --destructive)
            DESTRUCTIVE_AUTH=1
            shift
            ;;
        --confirm-disk)
            CONFIRM_DISK_MATCH="${2:-}"
            shift 2
            ;;
        -h|--help)
            echo "Usage: $(basename "$0") [OPTIONS] [DEVICE]"
            echo "Options:"
            echo "  -d, --dry-run          Simulate installation without writing changes (DEFAULT)"
            echo "  --destructive          Allow destructive formatting and partition writes"
            echo "  --confirm-disk DEV     Explicit verification of target disk (e.g. --confirm-disk /dev/vda)"
            exit 0
            ;;
        *)
            if [[ -z "$TARGET_DEV" ]]; then
                TARGET_DEV="$1"
            fi
            shift
            ;;
    esac
done

echo "=========================================================="
echo "  SigmaOS Arch Linux Sovereign Installer"
echo "=========================================================="

if [[ -z "$TARGET_DEV" ]]; then
    echo "Available storage block devices:"
    lsblk -dpno NAME,SIZE,MODEL 2>/dev/null | grep -v "loop" || true
    echo ""
    echo "Usage: sigmaos-install [OPTIONS] <DEVICE>"
    echo "Example: sigmaos-install --dry-run /dev/vda"
    exit 0
fi

echo "[*] Target device selected: $TARGET_DEV"

# Storage safety verification: Active root guard
ACTIVE_ROOT_SRC=$(findmnt -no SOURCE / 2>/dev/null || true)
if [[ -n "$ACTIVE_ROOT_SRC" ]]; then
    ACTIVE_DISK=$(lsblk -no PKNAME "$ACTIVE_ROOT_SRC" 2>/dev/null || true)
    if [[ -n "$ACTIVE_DISK" && "$TARGET_DEV" =~ "$ACTIVE_DISK" ]]; then
        echo "[!] CRITICAL ERROR: Target $TARGET_DEV hosts the active running host root partition ($ACTIVE_ROOT_SRC)."
        echo "    Destructive installation to host root is forbidden."
        exit 1
    fi
fi

if [[ "$DESTRUCTIVE_AUTH" -eq 1 && "$CONFIRM_DISK_MATCH" == "$TARGET_DEV" ]]; then
    DRY_RUN=0
    echo "[!] DESTRUCTIVE MODE ACTIVATED FOR $TARGET_DEV"
else
    DRY_RUN=1
    echo "[*] DRY RUN MODE: Simulating partition and installation actions safely."
fi

echo "[*] Target partitioning validation complete."
if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "[✓] DRY-RUN SUCCESS: Zero disk modifications made."
fi
