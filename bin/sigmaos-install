#!/bin/bash
# sigmaos-install - SigmaOS full installation script
# Implements end-to-end installation modeled on Omarchy 4.0.5 install flow.
#
# Usage: sigmaos-install [--target /dev/sda] [--hostname sigmaos] [--username sigma]
#
# Steps:
#   1. Partition and format target disk
#   2. Install base packages (pacstrap equivalent)
#   3. Generate fstab
#   4. Copy SigmaOS system files (/etc, default/, bin/, shell/, boot/)
#   5. Configure bootloader (limine)
#   6. Enable services
#   7. Schedule first-boot provisioning
#
# Design: fail-fast, defensive, modular (each phase is a separate function).

set -euo pipefail

TARGET_DEVICE=""
HOSTNAME="sigmaos"
USERNAME="sigma"
MOUNT_POINT="/mnt/sigmaos"
CONFIRM_DESTRUCTIVE=0
DRY_RUN=0

log_info()  { echo "[sigmaos-install] [INFO]  $*" >&2; }
log_step()  { echo "[sigmaos-install] [STEP]  $*" >&2; }
log_warn()  { echo "[sigmaos-install] [WARN]  $*" >&2; }
log_error() { echo "[sigmaos-install] [ERROR] $*" >&2; }

usage() {
  cat <<EOF
Usage: sigmaos-install --target DEVICE --yes-i-understand [--hostname NAME] [--username NAME]
  --target    Explicit target block device; no destructive default is used
  --hostname  System hostname (default: sigmaos)
  --username  Primary user account (default: sigma)
  --yes-i-understand  Confirm that the target device will be erased
  --dry-run   Validate arguments and required tools without changing disks
EOF
  exit 1
}

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --target) [[ $# -ge 2 ]] || { log_error "--target requires a device"; exit 1; }; TARGET_DEVICE="$2"; shift 2 ;;
    --hostname) HOSTNAME="$2"; shift 2 ;;
    --username) USERNAME="$2"; shift 2 ;;
    --yes-i-understand) CONFIRM_DESTRUCTIVE=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    --help|-h) usage ;;
    *) log_error "Unknown option: $1"; usage ;;
  esac
done

# ---------------------------------------------------------------------------
# Determine SigmaOS root directory for source files
# Run from repo root: files are at ./etc, ./default, ./bin, etc.
# Installed to /usr/bin: files are at /usr/share/sigmaos/etc, /usr/share/sigmaos/default, etc.
# ---------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -d "/usr/share/sigmaos/etc" ]; then
  SIGMAOS_ROOT="/usr/share/sigmaos"
else
  SIGMAOS_ROOT="${SCRIPT_DIR}/.."
fi
export SIGMAOS_ROOT

log_info "SigmaOS root: ${SIGMAOS_ROOT}"

# ---------------------------------------------------------------------------
# Phase 1: Pre-flight checks
# ---------------------------------------------------------------------------
preflight() {
  log_step "Pre-flight checks"
  if [[ -z "${TARGET_DEVICE}" ]]; then
    log_error "An explicit --target device is required"
    exit 1
  fi
  if [[ "${TARGET_DEVICE}" != /dev/* ]]; then
    log_error "Target must be a device path under /dev: ${TARGET_DEVICE}"
    exit 1
  fi
  if [[ "${DRY_RUN}" -eq 0 && "${CONFIRM_DESTRUCTIVE}" -ne 1 ]]; then
    log_error "Refusing destructive install without --yes-i-understand"
    exit 1
  fi
  if [[ "${DRY_RUN}" -eq 0 && $EUID -ne 0 ]]; then
    log_error "Must run as root"
    exit 1
  fi
  if [[ "${DRY_RUN}" -eq 0 && ! -b "${TARGET_DEVICE}" ]]; then
    log_error "Target device ${TARGET_DEVICE} not found"
    exit 1
  fi
  log_info "Target device: ${TARGET_DEVICE}"
  log_info "Hostname: ${HOSTNAME}"
  log_info "Username: ${USERNAME}"
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    log_info "Dry-run: no device changes will be made"
    return
  fi
  if findmnt -rn -S "${TARGET_DEVICE}" >/dev/null 2>&1; then
    log_error "Target device or one of its partitions is mounted"
    exit 1
  fi
  if findmnt -rn -T / | grep -q "${TARGET_DEVICE}"; then
    log_error "Refusing to overwrite the device hosting the running system"
    exit 1
  fi
  for tool in parted mkfs.fat mkfs.ext4 mount blkid; do
    command -v "${tool}" >/dev/null 2>&1 || { log_error "Required tool missing: ${tool}"; exit 1; }
  done
  command -v pacstrap >/dev/null 2>&1 || {
    log_error "pacstrap is required; refusing to install packages into the host system"
    exit 1
  }
}

partition_path() {
  if [[ "${TARGET_DEVICE}" =~ (nvme|mmcblk|loop)[0-9]+$ ]]; then
    printf '%s p%s\n' "${TARGET_DEVICE}" "$1" | tr -d ' '
  else
    printf '%s%s\n' "${TARGET_DEVICE}" "$1"
  fi
}

# ---------------------------------------------------------------------------
# Phase 2: Partition and format
# ---------------------------------------------------------------------------
partition() {
  log_step "Partitioning ${TARGET_DEVICE}"
  # Create GPT with EFI + root partitions
  parted -s "${TARGET_DEVICE}" mklabel gpt
  parted -s "${TARGET_DEVICE}" mkpart ESP fat32 1MiB 512MiB
  parted -s "${TARGET_DEVICE}" set 1 esp on
  parted -s "${TARGET_DEVICE}" mkpart primary ext4 512MiB 100%
  
  # Format
  EFI_PARTITION="$(partition_path 1)"
  ROOT_PARTITION="$(partition_path 2)"
  mkfs.fat -F 32 "${EFI_PARTITION}"
  mkfs.ext4 -F "${ROOT_PARTITION}"
  
  # Mount
  mkdir -p "${MOUNT_POINT}"
  mount "${ROOT_PARTITION}" "${MOUNT_POINT}"
  mkdir -p "${MOUNT_POINT}/boot"
  mount "${EFI_PARTITION}" "${MOUNT_POINT}/boot"
  
  log_info "Partitioned and mounted ${TARGET_DEVICE}"
}

# ---------------------------------------------------------------------------
# Phase 3: Install base packages
# ---------------------------------------------------------------------------
install_packages() {
  log_step "Installing base packages"
  
  [[ -r "${SIGMAOS_ROOT}/install/packages/sigmaos-base.packages" ]] || {
    log_error "Base package manifest is missing"
    exit 1
  }
  pacstrap "${MOUNT_POINT}" - < "${SIGMAOS_ROOT}/install/packages/sigmaos-base.packages"
}

# ---------------------------------------------------------------------------
# Phase 4: Generate fstab
# ---------------------------------------------------------------------------
generate_fstab() {
  log_step "Generating fstab"
  command -v genfstab >/dev/null 2>&1 || { log_error "genfstab is required"; exit 1; }
  genfstab -U "${MOUNT_POINT}" > "${MOUNT_POINT}/etc/fstab"
}

# ---------------------------------------------------------------------------
# Phase 5: Copy SigmaOS system files
# ---------------------------------------------------------------------------
copy_system_files() {
  log_step "Copying SigmaOS system files"
  
  # Copy /etc configuration
  cp -a "${SIGMAOS_ROOT}/etc"/* "${MOUNT_POINT}/etc/" 2>/dev/null || true
  
  # Copy /usr/share/sigmaos defaults
  mkdir -p "${MOUNT_POINT}/usr/share/sigmaos"
  cp -a "${SIGMAOS_ROOT}/default"/* "${MOUNT_POINT}/usr/share/sigmaos/default/" 2>/dev/null || true
  cp -a "${SIGMAOS_ROOT}/shell"/* "${MOUNT_POINT}/usr/share/sigmaos/shell/" 2>/dev/null || true
  
  # Copy install helpers
  mkdir -p "${MOUNT_POINT}/usr/share/sigmaos/install/helpers"
  cp -a "${SIGMAOS_ROOT}/install/helpers"/* "${MOUNT_POINT}/usr/share/sigmaos/install/helpers/" 2>/dev/null || true
  
  # Copy runtime binaries
  mkdir -p "${MOUNT_POINT}/usr/bin"
  cp -a "${SIGMAOS_ROOT}/bin"/* "${MOUNT_POINT}/usr/bin/" 2>/dev/null || true
  
  # Copy Plymouth theme
  mkdir -p "${MOUNT_POINT}/usr/share/plymouth/themes/sigmaos"
  cp -a "${SIGMAOS_ROOT}/usr/share/plymouth/themes/sigmaos"/* "${MOUNT_POINT}/usr/share/plymouth/themes/sigmaos/" 2>/dev/null || true
  
  # Copy bootloader config
  mkdir -p "${MOUNT_POINT}/boot/limine"
  cp -a "${SIGMAOS_ROOT}/boot/limine"/* "${MOUNT_POINT}/boot/limine/" 2>/dev/null || true
  
  # Copy /etc/skel dotfiles
  cp -a "${SIGMAOS_ROOT}/etc/skel"/. "${MOUNT_POINT}/etc/skel/" 2>/dev/null || true
  
  # Copy systemd user services
  mkdir -p "${MOUNT_POINT}/etc/systemd/user"
  cp -a "${SIGMAOS_ROOT}/etc/systemd/user"/* "${MOUNT_POINT}/etc/systemd/user/" 2>/dev/null || true
  
  log_info "System files copied to ${MOUNT_POINT}"
}

# ---------------------------------------------------------------------------
# Phase 6: Configure bootloader (limine)
# ---------------------------------------------------------------------------
configure_bootloader() {
  log_step "Configuring limine bootloader"
  
  # Replace UUID placeholder in limine.conf
  ROOT_UUID=$(blkid -s UUID -o value "$(partition_path 2)" 2>/dev/null)
  [[ -n "${ROOT_UUID}" ]] || { log_error "Could not determine root filesystem UUID"; exit 1; }
  if [ -f "${MOUNT_POINT}/boot/limine/limine.conf" ]; then
    sed -i "s/__ROOT_UUID__/${ROOT_UUID}/g" "${MOUNT_POINT}/boot/limine/limine.conf"
  fi
  
  # Install limine to EFI partition
  EFI_PARTITION="$(partition_path 1)"
  if command -v limine-deploy >/dev/null 2>&1; then
    limine-deploy --efi "${EFI_PARTITION}"
  elif command -v limine-install >/dev/null 2>&1; then
    limine-install "${EFI_PARTITION}"
  else
    log_error "No Limine installer found; refusing to leave an unbootable system"
    exit 1
  fi
  
  log_info "Bootloader configured"
}

# ---------------------------------------------------------------------------
# Phase 7: Enable services and first-boot provisioning
# ---------------------------------------------------------------------------
enable_services() {
  log_step "Enabling services and first-boot provisioning"
  
  # Enable services via systemctl in the target
  if command -v arch-chroot >/dev/null 2>&1; then
    arch-chroot "${MOUNT_POINT}" systemctl enable sddm.service 2>/dev/null || true
    arch-chroot "${MOUNT_POINT}" systemctl enable wireplumber.service 2>/dev/null || true
    arch-chroot "${MOUNT_POINT}" systemctl enable plymouth-start.service 2>/dev/null || true
    arch-chroot "${MOUNT_POINT}" systemctl enable sigmaos-provision-owner.service 2>/dev/null || true
    arch-chroot "${MOUNT_POINT}" systemctl enable theme-system.service 2>/dev/null || true
    arch-chroot "${MOUNT_POINT}" systemctl enable zram-generator.service 2>/dev/null || true
    arch-chroot "${MOUNT_POINT}" systemctl enable sigmaos-desktop-session.service 2>/dev/null || true
    arch-chroot "${MOUNT_POINT}" systemctl enable sigmaos-shell.service 2>/dev/null || true
    
    # Rebuild initramfs with Plymouth hooks
    arch-chroot "${MOUNT_POINT}" mkinitcpio -P 2>/dev/null || \
      arch-chroot "${MOUNT_POINT}" dracut -f 2>/dev/null || true
  fi
  
  # Mark provisioning as not-yet-done (first-boot will run setup-form.sh)
  rm -f "${MOUNT_POINT}/var/lib/sigmaos/provisioned" 2>/dev/null || true
  
  log_info "Services enabled, first-boot provisioning scheduled"
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
  preflight
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    log_step "Dry-run complete"
    return 0
  fi
  partition
  install_packages
  generate_fstab
  copy_system_files
  configure_bootloader
  enable_services
  
  log_step "SigmaOS installation complete!"
  log_info "Target: ${TARGET_DEVICE}"
  log_info "Reboot into SigmaOS to begin first-boot provisioning."
}

main "$@"
