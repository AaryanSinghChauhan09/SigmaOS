#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# sigmaos-local-ai — Turnkey Local LLM & AI Engine Manager (Ollama / LM Studio)
# Manages local model inference daemons and hardware acceleration on Arch/SigmaOS.
#
# Usage:
#   sigmaos-local-ai status
#   sigmaos-local-ai install [ollama|lm-studio]
#   sigmaos-local-ai start
#   sigmaos-local-ai stop
#   sigmaos-local-ai pull <model-name> (e.g. qwen2.5-coder, deepseek-r1)
#   sigmaos-local-ai list

set -euo pipefail

CYAN='\033[0;36m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'
BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${CYAN}[local-ai]${RESET} $*"; }
success() { echo -e "${GREEN}[local-ai]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[local-ai]${RESET} $*"; }
err()     { echo -e "${RED}[local-ai]${RESET} $*" >&2; }

cmd="${1:-status}"
shift 2>/dev/null || true

case "$cmd" in
  status)
    echo -e "\n${BOLD}${CYAN}  SigmaOS Local AI Infrastructure Status${RESET}\n"
    if pgrep -x ollama &>/dev/null; then
      echo -e "  Ollama Daemon:    ${GREEN}ACTIVE${RESET} (http://localhost:11434)"
    else
      echo -e "  Ollama Daemon:    ${YELLOW}INACTIVE${RESET}"
    fi
    if command -v ollama &>/dev/null; then
      echo ""
      info "Local models installed:"
      ollama list 2>/dev/null || true
    fi
    echo ""
    ;;

  start)
    info "Starting Ollama inference engine with GPU acceleration..."
    if command -v systemctl &>/dev/null; then
      sudo systemctl start ollama || ollama serve &
    else
      ollama serve & disown
    fi
    success "Ollama daemon running"
    ;;

  stop)
    info "Stopping Ollama daemon..."
    if command -v systemctl &>/dev/null; then
      sudo systemctl stop ollama || pkill -x ollama || true
    else
      pkill -x ollama || true
    fi
    success "Ollama stopped"
    ;;

  pull)
    model="${1:-}"
    [[ -z "$model" ]] && { err "Usage: sigmaos-local-ai pull <model-name>"; exit 1; }
    info "Pulling optimized model weights: ${BOLD}$model${RESET}..."
    ollama pull "$model"
    success "Model $model ready for local coding agents"
    ;;

  install)
    target="${1:-ollama}"
    case "$target" in
      ollama)
        info "Installing Ollama on Arch/SigmaOS..."
        if command -v pacman &>/dev/null; then
          sudo pacman -S --needed ollama
        else
          curl -fsSL https://ollama.com/install.sh | sh
        fi
        success "Ollama installed. Enable with: sudo systemctl enable --now ollama"
        ;;
      lm-studio)
        info "Installing LM Studio AppImage..."
        mkdir -p "$HOME/.local/bin"
        success "Download latest from: https://lmstudio.ai/"
        ;;
    esac
    ;;

  list)
    if command -v ollama &>/dev/null; then
      ollama list
    else
      warn "Ollama is not installed. Run: sigmaos-local-ai install ollama"
    fi
    ;;

  *)
    echo "Usage: sigmaos-local-ai [status|install|start|stop|pull <model>|list]"
    exit 1
    ;;
esac
