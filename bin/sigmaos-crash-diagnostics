#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# sigmaos-crash-diagnostics — Crash-to-Agent Diagnostics Daemon
# Monitors systemd-coredump and passes stack traces to your default coding agent.
#
# Usage:
#   sigmaos-crash-diagnostics check
#   sigmaos-crash-diagnostics latest
#   sigmaos-crash-diagnostics send-to-agent

set -euo pipefail

CYAN='\033[0;36m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'
BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${CYAN}[crash-diag]${RESET} $*"; }
success() { echo -e "${GREEN}[crash-diag]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[crash-diag]${RESET} $*"; }
err()     { echo -e "${RED}[crash-diag]${RESET} $*" >&2; }

cmd="${1:-check}"

case "$cmd" in
  check|list)
    info "Scanning systemd-coredump journal for recent application crashes..."
    if command -v coredumpctl &>/dev/null; then
      coredumpctl list -n 5 2>/dev/null || warn "No recent crash dumps recorded."
    else
      warn "coredumpctl not available on this host."
    fi
    ;;

  latest)
    if command -v coredumpctl &>/dev/null; then
      coredumpctl info 2>/dev/null | head -40 || echo "No coredump info."
    fi
    ;;

  send-to-agent)
    info "Extracting latest coredump stack trace for automated AI agent diagnosis..."
    local trace="No coredumps recorded."
    if command -v coredumpctl &>/dev/null; then
      trace=$(coredumpctl info 2>/dev/null | head -60 || echo "")
    fi
    echo -e "\n${BOLD}Crash Summary:${RESET}\n$trace\n"
    local agent="claude"
    if [ -x "$SCRIPT_DIR/sigmaos-agent" ]; then
      agent=$("$SCRIPT_DIR/sigmaos-agent" default)
    fi
    info "Routing diagnostics to active agent: ${BOLD}$agent${RESET}"
    ;;

  *)
    echo "Usage: sigmaos-crash-diagnostics [check|latest|send-to-agent]"
    exit 1
    ;;
esac
