#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# sigmaos-default-editor — System-Wide Default Editor Switcher
# Switch between Neovim (default), VSCode, Cursor, Zed, Sublime Text, Helix, Vim, or Emacs.
#
# Usage:
#   sigmaos-default-editor [list|get]
#   sigmaos-default-editor set <editor>
#   sigmaos-default-editor menu (Rofi selector)

set -euo pipefail

CYAN='\033[0;36m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'
BOLD='\033[1m'; RESET='\033[0m'

STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/sigmaos/default-editor"
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d/10-editor.conf"
mkdir -p "$(dirname "$STATE_FILE")" "$(dirname "$ENV_FILE")"

EDITORS=(
  "nvim:Neovim Extensible Text Editor (Default)"
  "code:Visual Studio Code"
  "cursor:Cursor AI Code Editor"
  "zed:Zed High-Performance GPU Editor"
  "subl:Sublime Text"
  "helix:Helix Modern Modal Terminal Editor"
  "vim:Classic Vi Improved"
  "emacs:GNU Emacs Extensible Environment"
)

get_editor() {
  if [ -f "$STATE_FILE" ]; then
    cat "$STATE_FILE"
  else
    echo "nvim"
  fi
}

set_editor() {
  local ed="$1"
  local valid=0
  for item in "${EDITORS[@]}"; do
    if [[ "${item%%:*}" == "$ed" ]]; then
      valid=1
      break
    fi
  done

  if [ "$valid" -eq 0 ]; then
    echo -e "${RED}[error]${RESET} Unsupported editor: $ed. Supported: nvim, code, cursor, zed, subl, helix, vim, emacs" >&2
    exit 1
  fi

  echo "$ed" > "$STATE_FILE"
  echo "EDITOR=$ed" > "$ENV_FILE"
  echo "VISUAL=$ed" >> "$ENV_FILE"

  echo -e "${GREEN}[editor]${RESET} Default editor set to: ${BOLD}$ed${RESET}"
  echo -e "${CYAN}[editor]${RESET} Persisted to $ENV_FILE and $STATE_FILE"
}

cmd="${1:-get}"
shift 2>/dev/null || true

case "$cmd" in
  get|current)
    get_editor
    ;;

  list)
    echo -e "\n${BOLD}${CYAN}  SigmaOS Supported Editors${RESET}\n"
    current=$(get_editor)
    for item in "${EDITORS[@]}"; do
      name="${item%%:*}"
      desc="${item#*:}"
      installed="not installed"
      if command -v "$name" &>/dev/null; then
        installed="${GREEN}installed${RESET}"
      fi
      if [ "$name" = "$current" ]; then
        echo -e "  ${GREEN}▶${RESET} ${BOLD}$name${RESET} \t($installed) — $desc ${CYAN}[active]${RESET}"
      else
        echo -e "    ${BOLD}$name${RESET} \t($installed) — $desc"
      fi
    done
    echo ""
    ;;

  set)
    target="${1:-}"
    [[ -z "$target" ]] && { echo "Usage: sigmaos-default-editor set <editor>"; exit 1; }
    set_editor "$target"
    ;;

  menu)
    choices=""
    for item in "${EDITORS[@]}"; do
      name="${item%%:*}"
      desc="${item#*:}"
      choices+="$name: $desc\n"
    done
    if command -v rofi &>/dev/null && [ -n "${WAYLAND_DISPLAY:-}" ]; then
      selected=$(echo -e "$choices" | rofi -dmenu -p " 📝 Default Editor " -theme ~/.config/rofi/sigmaos.rasi | cut -d: -f1)
      if [ -n "$selected" ]; then
        set_editor "$selected"
      fi
    else
      echo -e "$choices"
    fi
    ;;

  *)
    echo "Usage: sigmaos-default-editor [get|list|set <editor>|menu]"
    exit 1
    ;;
esac
