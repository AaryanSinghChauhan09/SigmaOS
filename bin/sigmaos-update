#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# sigmaos-update — SigmaOS system updater (packages + dotfiles + theme)
# Analogous to Omarchy's update mechanism but fully SigmaOS-native.
#
# Usage:
#   sigmaos-update [--packages-only] [--dotfiles-only] [--theme-only] [--dry-run] [-h|--help]
#
# Exit statuses:
#   0  all updates applied
#   1  one or more steps failed (non-fatal; continues)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

# ── Colors ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'
BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${CYAN}[update]${RESET} $*"; }
success() { echo -e "${GREEN}[update]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[update]${RESET} $*"; }
err()     { echo -e "${RED}[update]${RESET} $*" >&2; }

usage() {
  cat <<'EOF'
sigmaos-update — SigmaOS system updater

USAGE
  sigmaos-update [OPTIONS]

OPTIONS
  --packages-only   Update system packages only (pacman -Syu)
  --dotfiles-only   Re-deploy sovereign desktop dotfiles only
  --theme-only      Re-apply Wallust colour theme only
  --dry-run         Print what would be done; make no changes
  -h, --help        Show this help

DESCRIPTION
  Without flags, runs the full update sequence:
    1. System package upgrade (pacman -Syu or apt upgrade)
    2. Dotfile re-deployment via setup_desktop_dotfiles.sh
    3. Wallust theme re-application

  Designed to be safe on live desktops: package upgrade aborts on conflict,
  dotfile deploy is idempotent, theme apply is non-destructive.
EOF
}

# ── Flag parsing ─────────────────────────────────────────────────────────────
DO_PACKAGES=1
DO_DOTFILES=1
DO_THEME=1
DRY_RUN=0

for arg in "$@"; do
  case "$arg" in
    --packages-only) DO_DOTFILES=0; DO_THEME=0 ;;
    --dotfiles-only) DO_PACKAGES=0; DO_THEME=0 ;;
    --theme-only)    DO_PACKAGES=0; DO_DOTFILES=0 ;;
    --dry-run)       DRY_RUN=1 ;;
    -h|--help)       usage; exit 0 ;;
    *) err "Unknown option: $arg"; usage; exit 1 ;;
  esac
done

ERRORS=0

# ── Step 1: System packages ──────────────────────────────────────────────────
update_packages() {
  info "Step 1/3 — System package upgrade"
  if [ "$DRY_RUN" = "1" ]; then
    warn "[DRY-RUN] Would run: pacman -Syu or apt upgrade"
    return 0
  fi

  if command -v pacman &>/dev/null; then
    info "Using pacman (Arch-based system)"
    # Root (systemd timer) runs pacman directly; users go through sudo.
    local PM="pacman"; [ "$(id -u)" -ne 0 ] && PM="sudo pacman"
    if $PM -Syu --noconfirm 2>&1; then
      success "pacman upgrade complete"
    else
      err "pacman upgrade failed (continuing)"
      ERRORS=$((ERRORS + 1))
    fi
  elif command -v apt &>/dev/null; then
    info "Using apt (Debian-based host)"
    local APT="apt-get"; [ "$(id -u)" -ne 0 ] && APT="sudo apt-get"
    if $APT update -qq && $APT upgrade -y 2>&1; then
      success "apt upgrade complete"
    else
      err "apt upgrade failed (continuing)"
      ERRORS=$((ERRORS + 1))
    fi
  else
    warn "No supported package manager found (pacman/apt). Skipping package step."
  fi
}

# ── Step 2: Desktop dotfiles ─────────────────────────────────────────────────
update_dotfiles() {
  info "Step 2/3 — Sovereign desktop dotfile re-deployment"
  local setup_script="$ROOT_DIR/scripts/setup_desktop_dotfiles.sh"

  if [ ! -f "$setup_script" ]; then
    err "setup_desktop_dotfiles.sh not found at $setup_script"
    ERRORS=$((ERRORS + 1))
    return
  fi

  local dry_flag=""
  [ "$DRY_RUN" = "1" ] && dry_flag="--dry-run"

  if bash "$setup_script" $dry_flag; then
    success "Dotfile re-deployment complete"
  else
    err "Dotfile deployment failed (continuing)"
    ERRORS=$((ERRORS + 1))
  fi
}

# ── Step 3: Wallust theme ────────────────────────────────────────────────────
update_theme() {
  info "Step 3/3 — Wallust colour theme re-application"
  if [ "$DRY_RUN" = "1" ]; then
    warn "[DRY-RUN] Would re-apply active Wallust theme"
    return 0
  fi

  local wallust_cache="${XDG_CACHE_HOME:-$HOME/.cache}/wallust"
  local current_theme_file="$wallust_cache/current-theme"

  if command -v wallust &>/dev/null; then
    if [ -f "$current_theme_file" ]; then
      local theme
      theme=$(cat "$current_theme_file")
      info "Re-applying theme: $theme"
      wallust theme "$theme" 2>/dev/null && success "Theme re-applied: $theme" || {
        warn "wallust theme re-apply failed; running 'wallust run' instead"
        wallust run 2>/dev/null || true
      }
    else
      warn "No current theme file found; skipping theme step"
    fi
  elif [ -f "$ROOT_DIR/bin/sigmaos-theme-bg-switcher" ]; then
    bash "$ROOT_DIR/bin/sigmaos-theme-bg-switcher" 2>/dev/null || true
    success "Theme re-applied via sigmaos-theme-bg-switcher"
  else
    warn "wallust not installed; skipping theme step"
  fi
}

# ── Main ─────────────────────────────────────────────────────────────────────
main() {
  echo -e "${BOLD}${CYAN}╔══════════════════════════════════════╗${RESET}"
  echo -e "${BOLD}${CYAN}║      SigmaOS System Updater          ║${RESET}"
  echo -e "${BOLD}${CYAN}╚══════════════════════════════════════╝${RESET}"
  [ "$DRY_RUN" = "1" ] && warn "DRY-RUN mode active — no changes will be made"
  echo ""

  [ "$DO_PACKAGES" = "1" ] && update_packages
  [ "$DO_DOTFILES" = "1" ] && update_dotfiles
  [ "$DO_THEME"    = "1" ] && update_theme

  echo ""
  if [ "$ERRORS" -gt 0 ]; then
    err "Update finished with $ERRORS error(s). Review output above."
    exit 1
  else
    success "SigmaOS update complete ✓"
  fi
}

main
