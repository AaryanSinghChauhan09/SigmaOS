#!/usr/bin/env bash
# sigmaos-settings - SigmaOS system settings manager
# SigmaOS settings manager.

set -euo pipefail

REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_PATH")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
SIGMAOS_PATH="${SIGMAOS_PATH:-$ROOT_DIR}"
SETTINGS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/sigmaos/settings.conf"

show_settings() {
    echo "=== SigmaOS System Settings ==="
    if [ -f "$SETTINGS_FILE" ]; then
        cat "$SETTINGS_FILE"
    else
        echo "Using default settings (Catppuccin Mocha / Zenith):"
        echo "theme=catppuccin-mocha"
        echo "background=default"
        echo "font=JetBrains Mono"
        echo "terminal=foot"
        echo "editor=micro"
        echo "browser=chromium"
        echo "persona=desktop"
    fi
}

set_setting() {
    local key="$1"
    local value="$2"
    if [ -z "$key" ] || [ -z "$value" ]; then
        echo "Usage: sigmaos-settings set <key> <value>" >&2
        exit 1
    fi
    mkdir -p "$(dirname "$SETTINGS_FILE")"
    if [ -f "$SETTINGS_FILE" ] && grep -q "^${key}=" "$SETTINGS_FILE"; then
        sed -i "s/^${key}=.*/${key}=${value}/" "$SETTINGS_FILE"
    else
        echo "${key}=${value}" >> "$SETTINGS_FILE"
    fi
    echo "Set ${key}=${value}"
}

gui_settings() {
    if command -v zenity >/dev/null 2>&1 && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
        local current
        current=$(show_settings)
        zenity --info --title="SigmaOS System Settings" --text="$current" --width=400 --height=300 2>/dev/null || show_settings
    else
        show_settings
    fi
}

case "${1:-}" in
    show|"")
        show_settings
        ;;
    --gui|gui)
        gui_settings
        ;;
    set)
        set_setting "${2:-}" "${3:-}"
        ;;
    --help|-h|help)
        echo "Usage: sigmaos-settings [show | set <key> <value> | gui]"
        ;;
    *)
        echo "Usage: sigmaos-settings [show | set <key> <value> | gui]" >&2
        exit 1
        ;;
esac
