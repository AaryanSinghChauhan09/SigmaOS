{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 38,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "custom/sigma-theme",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "cpu",
        "memory",
        "temperature",
        "disk",
        "network",
        "battery",
        "tray",
        "custom/update",
        "custom/power"
    ],
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate",
        "format": "{name}",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },
    "custom/launcher": {
        "format": " ⚡ ",
        "on-click": "rofi -show drun -theme ~/.config/rofi/sigmaos.rasi",
        "tooltip": false
    },
    "custom/sigma-theme": {
        "format": " 🎨 {} ",
        "exec": "cat ~/.cache/wallust/current-theme 2>/dev/null || echo 'default'",
        "on-click": "sigmaos-update --theme-only",
        "interval": 30,
        "tooltip": true,
        "tooltip-format": "Active Wallust theme. Click to re-apply."
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 45,
        "separate-outputs": true
    },
    "clock": {
        "format": "{:%a %b %d  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "interval": 2,
        "format": "  {usage}%",
        "max-length": 10,
        "tooltip-format": "CPU: {usage}% | Load: {load}"
    },
    "memory": {
        "interval": 5,
        "format": "  {used:.1f}G / {total:.1f}G",
        "max-length": 20,
        "tooltip-format": "RAM: {used:.2f}GiB / {total:.2f}GiB ({percentage}%)\nSwap: {swapUsed:.2f}GiB / {swapTotal:.2f}GiB"
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-critical": "🔥 {temperatureC}°C",
        "format-icons": ["", "", ""],
        "tooltip": true
    },
    "disk": {
        "interval": 30,
        "format": "  {percentage_used}%",
        "path": "/",
        "tooltip-format": "Disk /: {used} / {total} ({percentage_used}%)"
    },
    "network": {
        "format-wifi": "  {essid} ({signalStrength}%)",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-linked": "󰈀  (No IP)",
        "format-disconnected": "󰖪  Offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nGateway: {gwaddr}\nUp: {bandwidthUpBytes} Down: {bandwidthDownBytes}"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰖁  Muted",
        "format-icons": {
            "headphone": "",
            "hands-free": "󰂑",
            "headset": "󰂎",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "tooltip-format": "{desc} — {volume}%"
    },
    "battery": {
        "states": {
            "good": 90,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}% ⚡",
        "format-plugged": "󰂄  {capacity}%",
        "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "Battery: {capacity}% ({timeTo})"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "custom/update": {
        "format": " 🔄 ",
        "on-click": "foot --title 'SigmaOS Update' bash -c 'sigmaos-update; read -n1 -rp \"Done. Press any key...\"'",
        "tooltip": true,
        "tooltip-format": "Run sigmaos-update"
    },
    "custom/power": {
        "format": " ⏻ ",
        "on-click": "wlogout",
        "tooltip": false
    }
}
