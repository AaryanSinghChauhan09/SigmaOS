# Maintainer: AaryanSinghChauhan09 <AaryanSinghChauhan09@users.noreply.github.com>
pkgname=sigmaos-platform-qt
pkgver=0.1.0
pkgrel=1
pkgdesc="QObject signal-slot dispatcher and property bindings"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-platform-qt"
license=('GPL3')
makedepends=('rust' 'cargo')
groups=('sigmaos-platform')
source=("git+${url}.git#branch=main")
sha256sums=('SKIP')

build() {
    cd "SigmaOS-platform-qt"
    cargo build --release --all
}

check() {
    cd "SigmaOS-platform-qt"
    cargo test --all
}

package() {
    cd "SigmaOS-platform-qt"
    install -Dm755 "target/release/sigmaos-platform-qt" "${pkgdir}/usr/bin/sigmaos-platform-qt" 2>/dev/null || true
    install -Dm644 README.md "${pkgdir}/usr/share/doc/sigmaos-platform-qt/README.md"
}
