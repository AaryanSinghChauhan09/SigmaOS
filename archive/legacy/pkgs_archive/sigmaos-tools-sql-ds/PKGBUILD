# Maintainer: AaryanSinghChauhan09 <AaryanSinghChauhan09@users.noreply.github.com>
pkgname=sigmaos-tools-sql-ds
pkgver=0.1.0
pkgrel=1
pkgdesc="SigmaOS SQL analytics query engine"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-tools-sql-ds"
license=('GPL3')
makedepends=('rust' 'cargo')
groups=('sigmaos-tools' 'sigmaos-datascience')
source=("git+${url}.git#branch=main")
sha256sums=('SKIP')

build() {
    cd "SigmaOS-tools-sql-ds"
    cargo build --release --all
}

check() {
    cd "SigmaOS-tools-sql-ds"
    cargo test --all
}

package() {
    cd "SigmaOS-tools-sql-ds"
    install -Dm755 "target/release/sigmaos-tools-sql-ds" "${pkgdir}/usr/bin/sigmaos-tools-sql-ds" 2>/dev/null || true
    install -Dm644 README.md "${pkgdir}/usr/share/doc/sigmaos-tools-sql-ds/README.md"
}
