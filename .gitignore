# SigmaOS .gitignore - Prepared for Sovereign Distribution

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.dll
*.dylib
*.exe

# C/C++ build artifacts (Kernel/Bootloader)
*.o
*.obj
*.bin
*.elf
*.img
*.iso
*.iso.tmp
bootloader/*.bin
kernel/*.o
kernel/*.obj

# OS Environment / Virtualization
.venv/
env/
venv/
ENV/
Vagrant/
.vagrant/
build/
dist/
*.spec

# SigmaOS Specific Sovereign Data (PRIVATE)
.sigma_keys/
sessions/
SIGMA_VAULT/
identity_vault/
*.key
*.pem
*.crt
*.pub

# Logs and temporary diagnostic outputs
*.log
logs/
debug.txt
out.txt
out_s.txt
diag_output*.txt
test_results.txt
test_sigmaos_suite_output.txt
boot_output.txt
run_error.txt
dupes.txt
find_dupes.txt
singularity_output.txt
singularity_breaker_output.txt
status*.json
test_out.txt

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Project documentation (Keep these)
!README.md
!ARCHITECTURE_PRINCIPLES.md
!COSMOS_MANIFESTO.md
!HOW_TO_RUN_SIGMAOS.md
!HOW_TO_SHARE_SIGMAOS.md
!MARKET_COMPETITORS_ACCESSIBILITY.md
!SOVEREIGN_GUIDE.md
!ZERO_TRUST_ARCHITECTURE.md
!available_features.md
!requirements.txt
