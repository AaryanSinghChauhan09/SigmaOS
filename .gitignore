# SigmaOS .gitignore — Sovereign Distribution v3
# =================================================
# Prevents multi-GB push failures by excluding generated
# binaries, OS images, secrets, and build intermediates.

# ---- GENERATED BINARIES & IMAGES ----
*.iso
*.iso.tmp
*.img
*.bin
*.elf
*.exe
*.dll
*.so
*.dylib
*.out
*.a
*.lib

# ---- BUILD INTERMEDIATES ----
*.o
*.obj
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.spec
bootloader/*.bin
kernel/*.o
kernel/*.obj

# ---- NODE / WEB DEPENDENCIES ----
node_modules/
**/node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ---- OS RUNTIME / SECRETS ----
.venv/
venv/
env/
ENV/
.vagrant/
Vagrant/
.sigma_keys/
sessions/
SIGMA_VAULT/
identity_vault/
*.key
*.pem
*.crt
*.pub

# ---- LOGS & TEMP OUTPUTS ----
*.log
logs/
debug.txt
out.txt
out_s.txt
diag_output*.txt
test_results.txt
test_sigmaos_suite_output.txt
boot_output.txt
run_error.txt
dupes.txt
find_dupes.txt
singularity_output.txt
singularity_breaker_output.txt
status*.json
test_out.txt
fix_log.txt

# ---- EDITOR / IDE ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- FORCE-KEEP CRITICAL DOCS & SOURCE ----
!README.md
!OS_GUIDE.md
!requirements.txt
!*.c
!*.h
!*.cpp
!*.hpp
!*.rs
!*.asm
!*.html
!*.css
!*.js
!*.ts
!*.bat
!*.sh
!*.ps1
!*.py
!Makefile
!Dockerfile
!Vagrantfile
!*.json
!*.md
!userland/
!sigma_core/
!kernel/
!bootloader/
