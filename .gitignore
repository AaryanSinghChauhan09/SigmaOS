# SigmaOS .gitignore - Sovereign Distribution v2
# =================================================
# CRITICAL: Prevents multi-GB push failures on GitHub by excluding
# generated binaries, OS images, and node_modules from tracking.

# ----- GENERATED BINARIES (LARGE) -----
*.iso
*.iso.tmp
*.img
*.bin
*.elf
*.exe
*.dll
*.so
*.dylib
*.out
*.a
*.lib

# ----- BUILD INTERMEDIATES -----
*.o
*.obj
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.spec

# ----- NODE / WEB DEPENDENCIES (LARGEST OFFENDER) -----
node_modules/
**/node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ----- OS RUNTIME DATA -----
.venv/
venv/
env/
ENV/
.vagrant/
.sigma_keys/
sessions/
SIGMA_VAULT/
identity_vault/
*.key
*.pem
*.crt
*.pub

# ----- LOGS AND TEMP OUTPUTS -----
*.log
logs/
debug.txt
out.txt
out_s.txt
diag_output*.txt
test_results.txt
test_sigmaos_suite_output.txt
boot_output.txt
run_error.txt
dupes.txt
singularity_output.txt
status*.json
fix_log.txt

# ----- EDITOR / IDE -----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ----- KEEP CRITICAL SOURCE DOCS -----
!README.md
!SIGMAPEDIA_THE_SOVEREIGN_BOOK.md
!suggestions.md
!DOCS/
!DOCS/*.md
!kernel/*.c
!kernel/*.h
!kernel/*.rs
!kernel/*.asm
!userland/


# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.dll
*.dylib
*.exe

# C/C++ build artifacts (Kernel/Bootloader)
*.o
*.obj
*.bin
*.elf
*.img
*.iso
*.iso.tmp
bootloader/*.bin
kernel/*.o
kernel/*.obj

# OS Environment / Virtualization
.venv/
env/
venv/
ENV/
Vagrant/
.vagrant/
build/
dist/
*.spec

# SigmaOS Specific Sovereign Data (PRIVATE)
.sigma_keys/
sessions/
SIGMA_VAULT/
identity_vault/
*.key
*.pem
*.crt
*.pub

# Logs and temporary diagnostic outputs
*.log
logs/
debug.txt
out.txt
out_s.txt
diag_output*.txt
test_results.txt
test_sigmaos_suite_output.txt
boot_output.txt
run_error.txt
dupes.txt
find_dupes.txt
singularity_output.txt
singularity_breaker_output.txt
status*.json
test_out.txt

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Project documentation (Keep these)
!README.md
!ARCHITECTURE_PRINCIPLES.md
!COSMOS_MANIFESTO.md
!HOW_TO_RUN_SIGMAOS.md
!HOW_TO_SHARE_SIGMAOS.md
!MARKET_COMPETITORS_ACCESSIBILITY.md
!SOVEREIGN_GUIDE.md
!ZERO_TRUST_ARCHITECTURE.md
!available_features.md
!requirements.txt
