# Build artifacts and temporary files
/build/
/target/
**/target/
*.log
*.tmp
*.iso
*.bin
*.img
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.elf
.cache/
__pycache__/
*.pyc
*~
.DS_Store
# Documentation files: kept ONLY in wiki/, docs/, templates/docs/, .github/
# Root-level .md/.txt files are banned from main (move to docs branch)
*.md
*.txt
# Allow wiki directory (canonical wiki source)
!wiki/
!wiki/**
!wiki/**/*.md
# Allow docs directory (architecture plans, guides)
!docs/
!docs/**
!docs/**/*.md
# Allow templates/docs (scaffolding templates)
!templates/docs/
!templates/docs/*.md
# Allow GitHub-specific markdown
!.github/
!.github/**
!.github/**/*.md
