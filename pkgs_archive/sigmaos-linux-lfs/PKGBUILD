# Maintainer: AaryanSinghChauhan09 <AaryanSinghChauhan09@users.noreply.github.com>
pkgname=sigmaos-linux-lfs
pkgver=0.1.0
pkgrel=1
pkgdesc="SigmaOS Linux From Scratch build layer"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-linux-lfs"
license=('GPL3')
makedepends=('rust' 'cargo')
groups=('sigmaos-linux')
source=("git+${url}.git#branch=main")
sha256sums=('SKIP')

build() {
    cd "SigmaOS-linux-lfs"
    cargo build --release --all
}

check() {
    cd "SigmaOS-linux-lfs"
    cargo test --all
}

package() {
    cd "SigmaOS-linux-lfs"
    install -Dm755 "target/release/sigmaos-linux-lfs" "${pkgdir}/usr/bin/sigmaos-linux-lfs" 2>/dev/null || true
    install -Dm644 README.md "${pkgdir}/usr/share/doc/sigmaos-linux-lfs/README.md"
}
