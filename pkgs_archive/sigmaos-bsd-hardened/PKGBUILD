# Maintainer: AaryanSinghChauhan09 <AaryanSinghChauhan09@users.noreply.github.com>
pkgname=sigmaos-bsd-hardened
pkgver=0.1.0
pkgrel=1
pkgdesc="SigmaOS HardenedBSD security policy"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-bsd-hardened"
license=('GPL3')
makedepends=('rust' 'cargo')
groups=('sigmaos-bsd')
source=("git+${url}.git#branch=main")
sha256sums=('SKIP')

build() {
    cd "SigmaOS-bsd-hardened"
    cargo build --release --all
}

check() {
    cd "SigmaOS-bsd-hardened"
    cargo test --all
}

package() {
    cd "SigmaOS-bsd-hardened"
    install -Dm755 "target/release/sigmaos-bsd-hardened" "${pkgdir}/usr/bin/sigmaos-bsd-hardened" 2>/dev/null || true
    install -Dm644 README.md "${pkgdir}/usr/share/doc/sigmaos-bsd-hardened/README.md"
}
