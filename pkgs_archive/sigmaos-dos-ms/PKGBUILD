# Maintainer: AaryanSinghChauhan09 <AaryanSinghChauhan09@users.noreply.github.com>
pkgname=sigmaos-dos-ms
pkgver=0.1.0
pkgrel=1
pkgdesc="MS-DOS 6.22 FAT16 filesystem and memory driver emulation"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-dos-ms"
license=('GPL3')
makedepends=('rust' 'cargo')
groups=('sigmaos-dos')
source=("git+${url}.git#branch=main")
sha256sums=('SKIP')

build() {
    cd "SigmaOS-dos-ms"
    cargo build --release --all
}

check() {
    cd "SigmaOS-dos-ms"
    cargo test --all
}

package() {
    cd "SigmaOS-dos-ms"
    install -Dm755 "target/release/sigmaos-dos-ms" "${pkgdir}/usr/bin/sigmaos-dos-ms" 2>/dev/null || true
    install -Dm644 README.md "${pkgdir}/usr/share/doc/sigmaos-dos-ms/README.md"
}
