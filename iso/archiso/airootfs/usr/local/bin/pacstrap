#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# pacstrap: Arch Linux system bootstrap tool wrapper
set -euo pipefail

NEWROOT="${1:-}"
if [[ -z "$NEWROOT" || ! -d "$NEWROOT" ]]; then
    echo "Usage: pacstrap /mnt/target [packages...]" >&2
    exit 1
fi
shift

mkdir -p "$NEWROOT/var/lib/pacman" "$NEWROOT/etc"
pacman -r "$NEWROOT" --config /etc/pacman.conf -Sy --noconfirm "$@"
