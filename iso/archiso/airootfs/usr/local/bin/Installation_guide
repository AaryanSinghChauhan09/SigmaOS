#!/usr/bin/env bash
cat << 'EOF'
================================================================================
                    SigmaOS / Arch Linux Installation Guide
================================================================================

1. Verify network connection:
   $ ping archlinux.org

2. Launch automated installer:
   # sigmaos-install /dev/nvme0n1

3. Or install manually:
   # sgdisk -Z /dev/nvme0n1
   # mkfs.vfat -F32 /dev/nvme0n1p1
   # mkfs.btrfs /dev/nvme0n1p2
   # mount /dev/nvme0n1p2 /mnt
   # pacstrap /mnt base linux linux-firmware hyprland
   # arch-chroot /mnt

4. Reboot:
   # reboot

================================================================================
EOF
