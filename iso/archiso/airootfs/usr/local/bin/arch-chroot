#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# arch-chroot: Arch Linux chroot wrapper mounting /sys, /proc, /dev, /run
set -euo pipefail

CHROOT_DIR="${1:-}"
if [[ -z "$CHROOT_DIR" || ! -d "$CHROOT_DIR" ]]; then
    echo "Usage: arch-chroot /path/to/rootfs [command...]" >&2
    exit 1
fi
shift || true

mount -t proc /proc "$CHROOT_DIR/proc" 2>/dev/null || true
mount -t sysfs /sys "$CHROOT_DIR/sys" 2>/dev/null || true
mount --bind /dev "$CHROOT_DIR/dev" 2>/dev/null || true
mount --bind /run "$CHROOT_DIR/run" 2>/dev/null || true
mount --bind /etc/resolv.conf "$CHROOT_DIR/etc/resolv.conf" 2>/dev/null || true

chroot "$CHROOT_DIR" "${@:-/bin/bash}"
