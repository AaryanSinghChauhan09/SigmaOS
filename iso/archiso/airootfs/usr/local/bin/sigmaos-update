#!/usr/bin/env bash
# sigmaos-update — SigmaOS system updater for the installed/live system.
#
# Self-contained variant shipped inside the ISO (the full repo version lives
# in bin/sigmaos-update and expects the source tree layout).
#
# Usage:
#   sigmaos-update [--packages-only] [--dotfiles-only] [--theme-only] [--dry-run] [-h|--help]
#
# Exit statuses: 0 success, 1 partial failure (non-fatal steps are skipped).
set -uo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'
BOLD='\033[1m'; RESET='\033[0m'
info()    { echo -e "${CYAN}[update]${RESET} $*"; }
success() { echo -e "${GREEN}[update]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[update]${RESET} $*"; }
err()     { echo -e "${RED}[update]${RESET} $*" >&2; }

DO_PACKAGES=1; DO_DOTFILES=1; DO_THEME=1; DRY_RUN=0
for arg in "$@"; do
  case "$arg" in
    --packages-only)  DO_DOTFILES=0; DO_THEME=0 ;;
    --dotfiles-only)  DO_PACKAGES=0; DO_THEME=0 ;;
    --theme-only)     DO_PACKAGES=0; DO_DOTFILES=0 ;;
    --dry-run)        DRY_RUN=1 ;;
    -h|--help)        sed -n '2,12p' "$0"; exit 0 ;;
    *)                err "unknown option: $arg"; exit 2 ;;
  esac
done

# ── Step 1: packages ─────────────────────────────────────────────────────────
update_packages() {
  info "Step 1/3 — package update (pacman -Syu)"
  if [ "$DRY_RUN" = "1" ]; then
    warn "[DRY-RUN] would run: pacman -Syu --noconfirm"
    return 0
  fi
  if command -v pacman >/dev/null 2>&1; then
    # The systemd timer runs as root; interactive users need sudo.
    if [ "$(id -u)" -eq 0 ]; then
      pacman -Syu --noconfirm || { err "pacman -Syu failed"; return 1; }
    else
      sudo pacman -Syu --noconfirm || { err "pacman -Syu failed"; return 1; }
    fi
    success "Packages up to date"
  else
    warn "pacman not found; skipping package step"
  fi
}

# ── Step 2: dotfiles ─────────────────────────────────────────────────────────
# Re-deploy the stock SigmaOS desktop configs from /etc/skel for files the
# user has deleted. Existing user files are never overwritten (no-clobber).
update_dotfiles() {
  info "Step 2/3 — desktop dotfile check"
  local skel="/etc/skel/.config"
  [ -d "$skel" ] || { warn "no skel config at $skel; skipping"; return 0; }

  local deployed=0
  for home in /home/*/; do
    local user="$(basename "$home")"
    [ "$user" = "liveuser" ] && continue
    [ -d "$home" ] || continue
    while IFS= read -r -d '' src; do
      local rel="${src#$skel/}"
      local dst="${home}.config/$rel"
      if [ "$DRY_RUN" = "1" ]; then
        [ -e "$dst" ] || echo "  [dry-run] would deploy $rel -> $dst"
      elif [ ! -e "$dst" ]; then
        mkdir -p "$(dirname "$dst")"
        chown "$user:$user" "$(dirname "$dst")" 2>/dev/null || true
        # The timer runs as root — hand the file to the owning user or they
        # cannot edit their own configs.
        if cp -a "$src" "$dst" && chown -R "$user:$user" "$dst" 2>/dev/null; then
          deployed=$((deployed + 1))
        fi
      fi
    done < <(find "$skel" -type f -print0 2>/dev/null)
  done
  success "Dotfiles checked ($deployed files restored)"
}

# ── Step 3: theme ────────────────────────────────────────────────────────────
update_theme() {
  info "Step 3/3 — Wallust theme re-application"
  if [ "$DRY_RUN" = "1" ]; then
    warn "[DRY-RUN] would re-apply active Wallust theme"
    return 0
  fi
  if command -v wallust >/dev/null 2>&1; then
    # Re-derive the palette from the current wallpaper and re-render the
    # Hyprland/Waybar templates. The systemd timer runs as root, so theme
    # the first real user's config rather than /root's.
    local home="$HOME" user=""
    if [ "$(id -u)" -eq 0 ]; then
      for d in /home/*/; do
        user="$(basename "$d")"
        [ "$user" = "liveuser" ] && continue
        home="${d%/}"; break
      done
    fi
    local wp="$home/.config/hypr/wallpaper.png"
    if [ -f "$wp" ]; then
      local ok=1
      if [ "$(id -u)" -eq 0 ] && [ -n "$user" ]; then
        runuser -u "$user" -- env HOME="$home" wallust run "$wp" || ok=0
      else
        wallust run "$wp" || ok=0
      fi
      [ "$ok" = "1" ] && success "Theme re-applied from $wp" || warn "wallust run failed"
    else
      warn "wallpaper not found at $wp; skipping theme step"
    fi
  else
    warn "wallust not installed; skipping theme step"
  fi
}

main() {
  echo -e "${BOLD}${CYAN}=== SigmaOS System Updater ===${RESET}"
  [ "$DRY_RUN" = "1" ] && warn "DRY-RUN mode — no changes will be made"
  [ "$DO_PACKAGES" = "1" ] && update_packages
  [ "$DO_DOTFILES" = "1" ] && update_dotfiles
  [ "$DO_THEME"    = "1" ] && update_theme
  success "Update complete"
}

main "$@"
exit 0
