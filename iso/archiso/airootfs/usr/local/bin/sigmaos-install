#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# sigmaos-install: SigmaOS installer — Btrfs + GRUB + Hyprland.
# DEFENSIVE SAFETY: defaults to DRY_RUN. A real install requires BOTH
# --destructive AND --confirm-disk <DEV>, run as root.
set -euo pipefail

DRY_RUN=1
DESTRUCTIVE_AUTH=0
CONFIRM_DISK_MATCH=""
TARGET_DEV=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--dry-run)      DRY_RUN=1; shift ;;
        --destructive)     DESTRUCTIVE_AUTH=1; shift ;;
        --confirm-disk)    CONFIRM_DISK_MATCH="${2:-}"; shift 2 ;;
        -h|--help)
            echo "Usage: $(basename "$0") [OPTIONS] [DEVICE]"
            echo "  -d, --dry-run          Simulate only (DEFAULT — writes nothing)"
            echo "  --destructive          Allow destructive partitioning"
            echo "  --confirm-disk DEV     Must equal the target disk to proceed"
            exit 0 ;;
        *) [[ -z "$TARGET_DEV" ]] && TARGET_DEV="$1"; shift ;;
    esac
done

echo "=========================================================="
echo "  SigmaOS Installer — Btrfs + GRUB + Hyprland"
echo "=========================================================="

if [[ -z "$TARGET_DEV" ]]; then
    echo "Available storage devices:"
    lsblk -dpno NAME,SIZE,MODEL 2>/dev/null | grep -v "loop" || true
    read -rp "Target disk (e.g. /dev/vda): " TARGET_DEV
fi
[[ -n "$TARGET_DEV" && -b "$TARGET_DEV" ]] || { echo "Error: '$TARGET_DEV' is not a block device." >&2; exit 1; }

# Refuse to touch the disk hosting the live/active root.
ACTIVE_ROOT_SRC="$(findmnt -no SOURCE / 2>/dev/null || true)"
ACTIVE_ROOT_DISK="$(lsblk -no PKNAME "$ACTIVE_ROOT_SRC" 2>/dev/null || true)"
ACTIVE_ROOT_DISK="${ACTIVE_ROOT_DISK:+/dev/$ACTIVE_ROOT_DISK}"
if [[ -n "$ACTIVE_ROOT_DISK" && "$TARGET_DEV" == "$ACTIVE_ROOT_DISK" ]]; then
    echo "FATAL: $TARGET_DEV hosts the running system root. Refusing." >&2; exit 1
fi
# Refuse if any partition on the target is mounted.
if findmnt -rn -S "$TARGET_DEV"* >/dev/null 2>&1 || grep -qs "^$TARGET_DEV" /proc/mounts; then
    echo "FATAL: partitions on $TARGET_DEV are mounted. Unmount first." >&2; exit 1
fi

if [[ $DESTRUCTIVE_AUTH -eq 1 && "$CONFIRM_DISK_MATCH" == "$TARGET_DEV" ]]; then
    DRY_RUN=0
fi

if [[ $DRY_RUN -eq 1 ]]; then
    cat <<EOF
[WARN] DRY RUN — nothing will be written.
[PLAN] Disk:        $TARGET_DEV
[PLAN]   p1: 1 GiB  FAT32   -> /boot   (EFI System Partition)
[PLAN]   p2: rest   Btrfs   -> /       subvols: @ @home @snapshots @var_log
[PLAN] FS:          btrfs compress=zstd:3,noatime
[PLAN] Bootloader:  GRUB (UEFI)
[PLAN] Desktop:     Hyprland + waybar + foot + thunar + pipewire
[PLAN] Packages:    ~60 curated (see pacstrap below)
To execute: sigmaos-install --destructive --confirm-disk $TARGET_DEV
EOF
    exit 0
fi

[[ $EUID -eq 0 ]] || { echo "Error: destructive install must run as root." >&2; exit 1; }

MNT=/mnt/sigmaos-target
PKGS="base base-devel linux linux-firmware linux-headers intel-ucode amd-ucode \
systemd systemd-sysvcompat sudo btrfs-progs efibootmgr grub pacman-contrib \
hyprland hyprpaper hypridle hyprlock waybar foot rofi-wayland mako dunst \
grim slurp swappy wl-clipboard cliphist \
xdg-desktop-portal-hyprland xdg-desktop-portal-gtk polkit-gnome \
pipewire pipewire-pulse pipewire-alsa pipewire-jack wireplumber pavucontrol \
brightnessctl playerctl networkmanager iwd bluez bluez-utils \
noto-fonts ttf-jetbrains-mono thunar neovim bash zsh starship \
git curl wget openssh rsync btop fastfetch"

echo "[1/9] Partitioning $TARGET_DEV (GPT)..."
sgdisk --zap-all "$TARGET_DEV"
sgdisk -n 1:0:+1024M -t 1:ef00 -c 1:SIGMAOS_EFI "$TARGET_DEV"
sgdisk -n 2:0:0      -t 2:8300 -c 2:SIGMAOS_ROOT "$TARGET_DEV"
[[ "$TARGET_DEV" =~ [0-9]$ ]] && { P_EFI="${TARGET_DEV}p1"; P_ROOT="${TARGET_DEV}p2"; } \
                             || { P_EFI="${TARGET_DEV}1";  P_ROOT="${TARGET_DEV}2"; }

echo "[2/9] Formatting partitions..."
mkfs.vfat -F32 -n SIGMAOS_EFI "$P_EFI"
mkfs.btrfs -f -L SIGMAOS_ROOT "$P_ROOT"

echo "[3/9] Creating Btrfs subvolumes..."
mkdir -p "$MNT"
mount "$P_ROOT" "$MNT"
for sv in @ @home @snapshots @var_log; do btrfs subvolume create "$MNT/$sv"; done
umount "$MNT"

echo "[4/9] Mounting subvolumes..."
mount -o noatime,compress=zstd:3,subvol=@         "$P_ROOT" "$MNT"
mkdir -p "$MNT"/{boot,home,.snapshots,var/log}
mount -o noatime,compress=zstd:3,subvol=@home      "$P_ROOT" "$MNT/home"
mount -o noatime,compress=zstd:3,subvol=@snapshots "$P_ROOT" "$MNT/.snapshots"
mount -o noatime,compress=zstd:3,subvol=@var_log   "$P_ROOT" "$MNT/var/log"
mount "$P_EFI" "$MNT/boot"

echo "[5/9] Writing fstab..."
cat > "$MNT/etc/fstab" <<'EOF'
LABEL=SIGMAOS_ROOT  /            btrfs  rw,noatime,compress=zstd:3,subvol=@          0 0
LABEL=SIGMAOS_ROOT  /home        btrfs  rw,noatime,compress=zstd:3,subvol=@home      0 0
LABEL=SIGMAOS_ROOT  /.snapshots  btrfs  rw,noatime,compress=zstd:3,subvol=@snapshots 0 0
LABEL=SIGMAOS_ROOT  /var/log     btrfs  rw,noatime,compress=zstd:3,subvol=@var_log   0 0
LABEL=SIGMAOS_EFI   /boot        vfat   rw,relatime,fmask=0022,dmask=0022            0 2
EOF

echo "[6/9] Installing system with pacstrap (~60 packages)..."
pacstrap "$MNT" $PKGS

# Strip the build-time IgnorePkg pin that would otherwise leak into the
# installed system and block openssl updates.
sed -i '/^IgnorePkg/d' "$MNT/etc/pacman.conf" 2>/dev/null || true
# Ensure a sane mirrorlist exists in the target.
[[ -s "$MNT/etc/pacman.d/mirrorlist" ]] || echo 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch' > "$MNT/etc/pacman.d/mirrorlist"

# Carry the SigmaOS desktop skeleton (Hyprland config, wallpaper, shell
# profile, starship prompt) into the installed system so new users get the
# branded desktop. /etc/skel/. already contains package-provided files;
# cp -a merges ours on top.
mkdir -p "$MNT/etc/skel"
cp -a /etc/skel/. "$MNT/etc/skel/" 2>/dev/null || true

# Carry the SigmaOS user-space tools so the installed system keeps
# sigmaos-update / sigmaos-snapshot / sigmaos-secureboot / provisioning.
mkdir -p "$MNT/usr/local/bin"
for tool in sigmaos-update sigmaos-snapshot sigmaos-secureboot sigmaos-provision-owner sigmaos-install; do
    [[ -x "/usr/local/bin/$tool" ]] && cp -a "/usr/local/bin/$tool" "$MNT/usr/local/bin/"
done
# sigmaos-update.service/.timer expect the tool; ship the units and enable
# the weekly timer.
for unit in sigmaos-update.service sigmaos-update.timer sigmaos-provision-owner.service; do
    [[ -f "/usr/lib/systemd/system/$unit" ]] && \
        cp -a "/usr/lib/systemd/system/$unit" "$MNT/usr/lib/systemd/system/"
done
mkdir -p "$MNT/etc/systemd/system/timers.target.wants"
[[ -f "$MNT/usr/lib/systemd/system/sigmaos-update.timer" ]] && \
    ln -sf /usr/lib/systemd/system/sigmaos-update.timer \
        "$MNT/etc/systemd/system/timers.target.wants/sigmaos-update.timer"

# Ship the SigmaOS pacman hooks (snapshots, cache prune, dotfile refresh)
# and sudoers drop-in so package transactions stay protected.
mkdir -p "$MNT/etc/pacman.d/hooks" "$MNT/etc/sudoers.d"
for hook in /etc/pacman.d/hooks/*sigmaos*.hook /etc/pacman.d/hooks/clean_package_cache.hook; do
    [[ -f "$hook" ]] && cp -a "$hook" "$MNT/etc/pacman.d/hooks/"
done
[[ -f /etc/sudoers.d/wheel ]] && cp -a /etc/sudoers.d/wheel "$MNT/etc/sudoers.d/"

echo "[7/9] Configuring bootloader (GRUB) + initramfs..."
arch-chroot "$MNT" bash -c '
    set -e
    # Ensure the kernel + initramfs exist, then build all presets.
    [[ -e /boot/vmlinuz-linux ]] || cp /usr/lib/modules/*/vmlinuz /boot/vmlinuz-linux
    mkinitcpio -P
    # Install GRUB for UEFI into the ESP mounted at /boot.
    grub-install --target=x86_64-efi --efi-directory=/boot \
        --bootloader-id=SigmaOS --recheck
    grub-mkconfig -o /boot/grub/grub.cfg
    systemctl enable NetworkManager bluetoothd fstrim.timer 2>/dev/null || true
'

echo "[8/9] First-boot configuration..."
read -rsp "Root password (leave empty to set later): " ROOT_PW || true
echo
# Pipe passwords via stdin — never embed them in the arch-chroot command
# line where they would be visible in the process list.
[[ -n "$ROOT_PW" ]] && printf 'root:%s\n' "$ROOT_PW" | arch-chroot "$MNT" chpasswd
read -rp "Username for daily use [sigma]: " USERNAME
USERNAME="${USERNAME:-sigma}"
[[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ ]] || { echo "Error: invalid username '$USERNAME'" >&2; exit 1; }
# The user gets sudo — they MUST have a password or sudo can never
# authenticate. Prompt twice and require a non-empty password.
while :; do
    read -rsp "Password for $USERNAME: " USER_PW; echo
    [[ -n "$USER_PW" ]] || { echo "A password is required for sudo access." >&2; continue; }
    read -rsp "Confirm password: " USER_PW2; echo
    [[ "$USER_PW" == "$USER_PW2" ]] && break
    echo "Passwords do not match — try again." >&2
done
arch-chroot "$MNT" bash -c "
    useradd -m -G wheel,audio,video,storage,input -s /bin/bash '$USERNAME' 2>/dev/null || true
    echo '$USERNAME ALL=(ALL) ALL' > /etc/sudoers.d/$USERNAME
    chmod 440 /etc/sudoers.d/$USERNAME
    echo 'en_US.UTF-8 UTF-8' > /etc/locale.gen
    locale-gen
    echo 'sigmaos' > /etc/hostname
    ln -sf /usr/share/zoneinfo/UTC /etc/localtime
"
printf '%s:%s\n' "$USERNAME" "$USER_PW" | arch-chroot "$MNT" chpasswd
unset USER_PW USER_PW2 ROOT_PW

# One-step desktop: autologin $USERNAME on tty1 so the installed system boots
# straight into Hyprland via the skel .bash_profile (same as the live ISO).
mkdir -p "$MNT/etc/systemd/system/getty@tty1.service.d"
cat > "$MNT/etc/systemd/system/getty@tty1.service.d/autologin.conf" <<EOF
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin $USERNAME --noclear %I \$TERM
EOF

echo "[9/9] Syncing and finishing..."
sync
arch-chroot "$MNT" true
echo "=========================================================="
echo "  SigmaOS installed on $TARGET_DEV"
echo "  User: $USERNAME (sudo via /etc/sudoers.d)"
echo "  Reboot and remove install media to boot SigmaOS."
echo "=========================================================="
