CompileFlags:
  Add:
    - -I./include
    - -I./kernel/core/include
    - -I.
    - -ffreestanding
    - -fno-stack-protector
    - -Wall
    - -Wextra
  Remove:
    - -mno-red-zone

If:
  PathMatch: .*\.cpp
CompileFlags:
  Add: [-std=c++17, -fno-exceptions, -fno-rtti]

If:
  PathMatch: .*\.c
CompileFlags:
  Add: [-std=c11]

Diagnostics:
  UnusedIncludes: None
