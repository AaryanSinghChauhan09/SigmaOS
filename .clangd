# =============================================================================
# SigmaOS — .clangd
# IDE Configuration for Sovereign Singularity
# =============================================================================
# Purpose:
#   Resolves recursive preamble errors in system headers (like stdint.h) 
#   by refining the include hierarchy and compiler flags.
# =============================================================================

CompileFlags:
  Add: [
    "-Iinclude",
    "-Ilibc",
    "-std=c11",
    "-Wall",
    "-Wextra",
    "-Wno-unknown-attributes",
    "-Wno-unused-function"
  ]
  Remove: ["-fprebuilt-module-path", "-fmodules"] # Disable modules to prevent recursion

Index:
  Background: true

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict

Hover:
  ShowAKA: true
