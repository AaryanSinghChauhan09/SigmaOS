# =============================================================================
# SigmaOS — .clangd
# IDE Configuration for Sovereign Singularity
# =============================================================================

CompileFlags:
  Add: [
    "-xc",
    "-std=c11",
    "-Iinclude",
    "-Ilibc",
    "-ffreestanding",
    "-nostdinc",
    "-D__SIGMAOS__",
    "-Wno-unknown-attributes"
  ]
  Remove: ["-fprebuilt-module-path", "-fmodules"]

Index:
  Background: true
  ExternalIndex: None

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict

# Prevent recursive preamble building in system-like headers
If:
  PathMatch: .*\.h
---
CompileFlags:
  Remove: [-include] # Never force-include anything into a header via flags
