CompileFlags:
  Add: [
    "-Ic:/Users/Sovereign/.gemini/antigravity/scratch/SigmaOS-Repo/include",
    "-Iinclude",
    "-Ikernel/core",
    "-Ikernel/drivers",
    "-Ikernel/orchestration",
    "-Ikernel/shards",
    "-m64",
    "-ffreestanding",
    "-fno-stack-protector",
    "-nostdlib",
    "-fno-exceptions",
    "-fno-rtti"
  ]
---
If:
  PathMatch: .*\.cpp
CompileFlags:
  Add: ["-std=c++11"]
---
If:
  PathMatch: .*\.c
CompileFlags:
  Add: ["-std=c11"]
