# =============================================================================
# SigmaOS — .clangd
# Industrial-grade IDE Configuration (TERMINAL SUPREMACY)
# =============================================================================

CompileFlags:
  Add: [
    "-xc",
    "-std=c11",
    "-Iinclude",
    "-Ilibc",
    "-ffreestanding",
    "-nostdinc",
    "-fno-modules",
    "-fno-ms-extensions",
    "-D__SIGMAOS__",
    "-Wno-unknown-attributes"
  ]
  Remove: ["-fprebuilt-module-path", "-fmodules"]

Index:
  Background: true
  ExternalIndex: None

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict

# Prevent Clangd from trying to build redundant preambles for system-like headers
If:
  PathMatch: .*\.h
---
CompileFlags:
  Add: [-fno-modules-cache]
  Remove: [-include]

# Terminal Fix for recursive stdint.h preamble bugs
If:
  PathMatch: .*stdint\.h
---
Diagnostics:
  Suppress: ["*"]

