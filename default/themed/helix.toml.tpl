# SigmaOS theme template for helix editor
# Copied to ~/.config/helix/config.toml by sigmaos-theme-system

[theme]
colorscheme = "catppuccin_mocha"

[editor]
line-number = "relative"
cursorline = true
cursorcolumn = true

[editor.format-on-save]
enable = false

[keys.normal]
"gf" = "goto_definition"
"K" = "hover"
