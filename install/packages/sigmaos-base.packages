# SigmaOS base package list
# Packages installed to make SigmaOS a working desktop OS.
# Modeled on Omarchy 4.0.5 install/omarchy-base.packages

# Core system
base
base-devel
linux-firmware
systemd
systemd-sysvcompat
grub
efibootmgr
dosfstools
btrfs-progs
zram-generator
arch-install-scripts
archinstall

# Bootloader (limine like Omarchy)
limine
limine-mkinitcpio-hook

# Omarchy 4.0.6 style packages
sigmaos-keyring
sigmaos-settings
sdparm
openbsd-netcat
xorg-xprop

# Display server & session
wayland
wayland-utils
xorg-server-xwayland
uwsm
seatd

# Compositor / Window Manager
hyprland
hyprlock
hypridle
swaylock

# Display manager
sddm

# Boot splash
plymouth
plymouth-theme-sigmaos

# Terminals
foot
ghostty

# Launcher
wofi

# Status bar
waybar

# Notifications
mako

# Audio
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
alsa-utils
pamixer
pavucontrol

# Input / input tools
libinput
xdotool
ydotool

# Screenshot / recording
grim
slurp
wf-recorder
gpu-screen-recorder
wl-clipboard

# File manager
nautilus
gvfs
gvfs-mtp
gvfs-nfs

# Browser
chromium
firefox

# Text editor
micro
helix

# System tools
fastfetch
btop
brightnessctl
power-profiles-daemon
gum
fzf
git
curl
wget
unzip
zip
tar
rsync

# Shell
bash
bash-completion
zsh

# Fonts
noto-fonts
noto-fonts-emoji
ttf-jetbrains-mono-nerd

# Theming / appearance
gtk4
gtk3
qt5-wayland
qt6-wayland
adwaita-icon-theme
papirus-icon-theme
cursor-themes
swww
hyprpaper

# Networking
networkmanager
network-manager-applet
bluez
bluez-utils
blueman

# Printing (CUPS - Omancy acceptance test requires cups.service enabled and running)
cups
cups-filters
cups-pk-helper
system-config-printer
print-manager

# Security / authentication
polkit-kde-agent
gnome-keyring
tpm2-tools
tpm2-tss

# Accessibility (Omancy 4.0.6 speakup screen reader)
speakup
espeakup
espeak-ng

# Recovery / rescue tools (Omancy-inspired)
clonezilla
drbl
testdisk

# Cloud provisioning (Omancy-style first-boot)
cloud-init

# Development (optional but useful)
gcc
clang
rustup
make
cmake

# SigmaOS specific
sigmaos
