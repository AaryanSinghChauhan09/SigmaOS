Checks: 'clang-diagnostic-*,clang-analyzer-*,bugprone-*,modernize-*,performance-*,readability-*,cppcoreguidelines-*,google-*'
WarningsAsErrors: 'bugprone-*,performance-*,google-*'
CheckOptions:
  - key:             readability-identifier-naming.VariableCase
    value:           lower_case
  - key:             readability-identifier-naming.FunctionCase
    value:           camelCase
  - key:             readability-identifier-naming.ClassCase
    value:           CamelCase
