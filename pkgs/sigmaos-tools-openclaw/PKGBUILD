# Maintainer: AaryanSinghChauhan09 <AaryanSinghChauhan09@users.noreply.github.com>
pkgname=sigmaos-tools-openclaw
pkgver=0.1.0
pkgrel=1
pkgdesc="SigmaOS OpenClaw game engine bridge"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-tools-openclaw"
license=('GPL3')
makedepends=('rust' 'cargo')
groups=('sigmaos-tools')
source=("git+${url}.git#branch=main")
sha256sums=('SKIP')

build() {
    cd "SigmaOS-tools-openclaw"
    cargo build --release --all
}

check() {
    cd "SigmaOS-tools-openclaw"
    cargo test --all
}

package() {
    cd "SigmaOS-tools-openclaw"
    install -Dm755 "target/release/sigmaos-tools-openclaw" "${pkgdir}/usr/bin/sigmaos-tools-openclaw" 2>/dev/null || true
    install -Dm644 README.md "${pkgdir}/usr/share/doc/sigmaos-tools-openclaw/README.md"
}
