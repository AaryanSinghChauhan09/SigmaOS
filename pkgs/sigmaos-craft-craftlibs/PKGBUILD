# Maintainer: AaryanSinghChauhan09 <AaryanSinghChauhan09@users.noreply.github.com>
pkgname=sigmaos-craft-craftlibs
pkgver=0.1.0
pkgrel=1
pkgdesc="Shared spatial math, affine transforms, and vectors"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-craft-craftlibs"
license=('GPL3')
makedepends=('rust' 'cargo')
groups=('sigmaos-craft')
source=("git+${url}.git#branch=main")
sha256sums=('SKIP')

build() {
    cd "SigmaOS-craft-craftlibs"
    cargo build --release --all
}

check() {
    cd "SigmaOS-craft-craftlibs"
    cargo test --all
}

package() {
    cd "SigmaOS-craft-craftlibs"
    install -Dm755 "target/release/sigmaos-craft-craftlibs" "${pkgdir}/usr/bin/sigmaos-craft-craftlibs" 2>/dev/null || true
    install -Dm644 README.md "${pkgdir}/usr/share/doc/sigmaos-craft-craftlibs/README.md"
}
