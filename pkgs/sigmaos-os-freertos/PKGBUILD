# Maintainer: SigmaOS Project <sigmaos@example.com>
pkgname=sigmaos-os-freertos
pkgver=0.1.0
pkgrel=1
pkgdesc="Deterministic real-time operating system — SigmaOS Operating System Integration"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-os-freertos"
license=('GPL-3.0-or-later')
groups=('sigmaos-os')
makedepends=('rust' 'cargo')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${pkgname}-${pkgver}"
  cargo build --release
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 "target/release/sigmaos-os-freertos" \
    "${pkgdir}/usr/bin/sigmaos-os-freertos"
}
