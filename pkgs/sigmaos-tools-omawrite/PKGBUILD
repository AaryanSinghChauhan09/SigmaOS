# Maintainer: Aaryan Singh Chauhan <aaryansinghchauhan@users.noreply.github.com>
pkgname=sigmaos-tools-omawrite
pkgver=0.1.0
pkgrel=1
pkgdesc="Distraction-free markdown and rich text editor (omacom/omawrite parity)"
arch=('x86_64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-tools-omawrite"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('rust' 'cargo')

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/omawrite" "$pkgdir/usr/bin/omawrite"
}
