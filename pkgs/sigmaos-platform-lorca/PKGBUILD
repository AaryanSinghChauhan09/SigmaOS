# Maintainer: SigmaOS Project <sigmaos@example.com>
pkgname=sigmaos-platform-lorca
pkgver=0.1.0
pkgrel=1
pkgdesc="HTML5 desktop apps in Go via Chrome — SigmaOS Platform Integration"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-platform-lorca"
license=('GPL-3.0-or-later')
groups=('sigmaos-platform')
makedepends=('rust' 'cargo')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${pkgname}-${pkgver}"
  cargo build --release
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 "target/release/sigmaos-platform-lorca" \
    "${pkgdir}/usr/bin/sigmaos-platform-lorca"
}
