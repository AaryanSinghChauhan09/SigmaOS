# Maintainer: AaryanSinghChauhan09 <AaryanSinghChauhan09@users.noreply.github.com>
pkgname=sigmaos-tools-command-code
pkgver=0.1.0
pkgrel=1
pkgdesc="AI-assisted command line terminal shell interpreter"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-tools-command-code"
license=('GPL3')
makedepends=('rust' 'cargo')
groups=('sigmaos-tools')
source=("git+${url}.git#branch=main")
sha256sums=('SKIP')

build() {
    cd "SigmaOS-tools-command-code"
    cargo build --release --all
}

check() {
    cd "SigmaOS-tools-command-code"
    cargo test --all
}

package() {
    cd "SigmaOS-tools-command-code"
    install -Dm755 "target/release/sigmaos-tools-command-code" "${pkgdir}/usr/bin/sigmaos-tools-command-code" 2>/dev/null || true
    install -Dm644 README.md "${pkgdir}/usr/share/doc/sigmaos-tools-command-code/README.md"
}
