# Maintainer: AaryanSinghChauhan09 <AaryanSinghChauhan09@users.noreply.github.com>
pkgname=sigmaos-rdbms-apache
pkgver=0.1.0
pkgrel=1
pkgdesc="SigmaOS Apache Derby/Hive query planner"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-rdbms-apache"
license=('GPL3')
makedepends=('rust' 'cargo')
groups=('sigmaos-rdbms')
source=("git+${url}.git#branch=main")
sha256sums=('SKIP')

build() {
    cd "SigmaOS-rdbms-apache"
    cargo build --release --all
}

check() {
    cd "SigmaOS-rdbms-apache"
    cargo test --all
}

package() {
    cd "SigmaOS-rdbms-apache"
    install -Dm755 "target/release/sigmaos-rdbms-apache" "${pkgdir}/usr/bin/sigmaos-rdbms-apache" 2>/dev/null || true
    install -Dm644 README.md "${pkgdir}/usr/share/doc/sigmaos-rdbms-apache/README.md"
}
