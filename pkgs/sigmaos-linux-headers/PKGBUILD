# Maintainer: SigmaOS Project <sigmaos@example.com>
pkgname=sigmaos-linux-headers
pkgver=6.12.0
pkgrel=1
pkgdesc="Headers and scripts for building modules for the SigmaOS Linux kernel"
arch=('x86_64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS"
license=('GPL-2.0-only')
depends=('pahole')

package() {
  install -d "${pkgdir}/usr/lib/modules/${pkgver}-sigmaos/build"
  echo "# SigmaOS Linux Kernel Headers" > "${pkgdir}/usr/lib/modules/${pkgver}-sigmaos/build/Makefile"
}
