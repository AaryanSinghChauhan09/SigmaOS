# Maintainer: Aaryan Singh Chauhan <aaryansinghchauhan@users.noreply.github.com>
pkgname=sigmaos-tools-omasnap
pkgver=0.1.0
pkgrel=1
pkgdesc="Wayland native screenshot utility with interactive region select (omacom/omasnap parity)"
arch=('x86_64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-tools-omasnap"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('rust' 'cargo')

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/omasnap" "$pkgdir/usr/bin/omasnap"
}
