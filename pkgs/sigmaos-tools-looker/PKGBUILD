# Maintainer: AaryanSinghChauhan09 <AaryanSinghChauhan09@users.noreply.github.com>
pkgname=sigmaos-tools-looker
pkgver=0.1.0
pkgrel=1
pkgdesc="SigmaOS Looker Studio BI bridge"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-tools-looker"
license=('GPL3')
makedepends=('rust' 'cargo')
groups=('sigmaos-tools' 'sigmaos-datascience')
source=("git+${url}.git#branch=main")
sha256sums=('SKIP')

build() {
    cd "SigmaOS-tools-looker"
    cargo build --release --all
}

check() {
    cd "SigmaOS-tools-looker"
    cargo test --all
}

package() {
    cd "SigmaOS-tools-looker"
    install -Dm755 "target/release/sigmaos-tools-looker" "${pkgdir}/usr/bin/sigmaos-tools-looker" 2>/dev/null || true
    install -Dm644 README.md "${pkgdir}/usr/share/doc/sigmaos-tools-looker/README.md"
}
