# Maintainer: AaryanSinghChauhan09 <AaryanSinghChauhan09@users.noreply.github.com>
pkgname=sigmaos-genoffice-pdf
pkgver=0.1.0
pkgrel=1
pkgdesc="SigmaOS GenOffice PDF annotator"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-genoffice-pdf"
license=('GPL3')
makedepends=('rust' 'cargo')
groups=('sigmaos-genoffice')
source=("git+${url}.git#branch=main")
sha256sums=('SKIP')

build() {
    cd "SigmaOS-genoffice-pdf"
    cargo build --release --all
}

check() {
    cd "SigmaOS-genoffice-pdf"
    cargo test --all
}

package() {
    cd "SigmaOS-genoffice-pdf"
    install -Dm755 "target/release/sigmaos-genoffice-pdf" "${pkgdir}/usr/bin/sigmaos-genoffice-pdf" 2>/dev/null || true
    install -Dm644 README.md "${pkgdir}/usr/share/doc/sigmaos-genoffice-pdf/README.md"
}
