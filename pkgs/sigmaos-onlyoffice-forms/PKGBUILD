# Maintainer: AaryanSinghChauhan09 <AaryanSinghChauhan09@users.noreply.github.com>
pkgname=sigmaos-onlyoffice-forms
pkgver=0.1.0
pkgrel=1
pkgdesc="SigmaOS OnlyOffice Forms builder"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-onlyoffice-forms"
license=('GPL3')
makedepends=('rust' 'cargo')
groups=('sigmaos-onlyoffice')
source=("git+${url}.git#branch=main")
sha256sums=('SKIP')

build() {
    cd "SigmaOS-onlyoffice-forms"
    cargo build --release --all
}

check() {
    cd "SigmaOS-onlyoffice-forms"
    cargo test --all
}

package() {
    cd "SigmaOS-onlyoffice-forms"
    install -Dm755 "target/release/sigmaos-onlyoffice-forms" "${pkgdir}/usr/bin/sigmaos-onlyoffice-forms" 2>/dev/null || true
    install -Dm644 README.md "${pkgdir}/usr/share/doc/sigmaos-onlyoffice-forms/README.md"
}
