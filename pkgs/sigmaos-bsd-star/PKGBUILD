# Maintainer: AaryanSinghChauhan09 <AaryanSinghChauhan09@users.noreply.github.com>
pkgname=sigmaos-bsd-star
pkgver=0.1.0
pkgrel=1
pkgdesc="SigmaOS StarBSD package signing"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-bsd-star"
license=('GPL3')
makedepends=('rust' 'cargo')
groups=('sigmaos-bsd')
source=("git+${url}.git#branch=main")
sha256sums=('SKIP')

build() {
    cd "SigmaOS-bsd-star"
    cargo build --release --all
}

check() {
    cd "SigmaOS-bsd-star"
    cargo test --all
}

package() {
    cd "SigmaOS-bsd-star"
    install -Dm755 "target/release/sigmaos-bsd-star" "${pkgdir}/usr/bin/sigmaos-bsd-star" 2>/dev/null || true
    install -Dm644 README.md "${pkgdir}/usr/share/doc/sigmaos-bsd-star/README.md"
}
