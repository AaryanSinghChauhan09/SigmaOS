# Maintainer: AaryanSinghChauhan09 <AaryanSinghChauhan09@users.noreply.github.com>
pkgname=sigmaos-craft-vector
pkgver=0.1.0
pkgrel=1
pkgdesc="Bézier curve segments, SVG path commands, and bounds"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-craft-vector"
license=('GPL3')
makedepends=('rust' 'cargo')
groups=('sigmaos-craft')
source=("git+${url}.git#branch=main")
sha256sums=('SKIP')

build() {
    cd "SigmaOS-craft-vector"
    cargo build --release --all
}

check() {
    cd "SigmaOS-craft-vector"
    cargo test --all
}

package() {
    cd "SigmaOS-craft-vector"
    install -Dm755 "target/release/sigmaos-craft-vector" "${pkgdir}/usr/bin/sigmaos-craft-vector" 2>/dev/null || true
    install -Dm644 README.md "${pkgdir}/usr/share/doc/sigmaos-craft-vector/README.md"
}
