# Maintainer: Aaryan Singh Chauhan <aaryansinghchauhan@users.noreply.github.com>
pkgname=sigmaos-tools-folio
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast sovereign file manager with keyboard navigation (omacom/folio parity)"
arch=('x86_64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-tools-folio"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('rust' 'cargo')

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/folio" "$pkgdir/usr/bin/folio"
}
