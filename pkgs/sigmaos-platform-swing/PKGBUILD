# Maintainer: SigmaOS Project <sigmaos@example.com>
pkgname=sigmaos-platform-swing
pkgver=0.1.0
pkgrel=1
pkgdesc="Java Foundation Classes lightweight UI — SigmaOS Platform Integration"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-platform-swing"
license=('GPL-3.0-or-later')
groups=('sigmaos-platform')
makedepends=('rust' 'cargo')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${pkgname}-${pkgver}"
  cargo build --release
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 "target/release/sigmaos-platform-swing" \
    "${pkgdir}/usr/bin/sigmaos-platform-swing"
}
