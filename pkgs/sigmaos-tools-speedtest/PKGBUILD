# Maintainer: Aaryan Singh Chauhan <aaryansinghchauhan@users.noreply.github.com>
pkgname=sigmaos-tools-speedtest
pkgver=0.1.0
pkgrel=1
pkgdesc="Lightweight bandwidth and network latency benchmarking tool (omacom/omarchy-speedtest parity)"
arch=('x86_64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-tools-speedtest"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('rust' 'cargo')

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/speedtest" "$pkgdir/usr/bin/speedtest"
}
