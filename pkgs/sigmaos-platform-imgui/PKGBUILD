# Maintainer: AaryanSinghChauhan09 <AaryanSinghChauhan09@users.noreply.github.com>
pkgname=sigmaos-platform-imgui
pkgver=0.1.0
pkgrel=1
pkgdesc="Immediate mode graphical user interface framework"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-platform-imgui"
license=('GPL3')
makedepends=('rust' 'cargo')
groups=('sigmaos-platform')
source=("git+${url}.git#branch=main")
sha256sums=('SKIP')

build() {
    cd "SigmaOS-platform-imgui"
    cargo build --release --all
}

check() {
    cd "SigmaOS-platform-imgui"
    cargo test --all
}

package() {
    cd "SigmaOS-platform-imgui"
    install -Dm755 "target/release/sigmaos-platform-imgui" "${pkgdir}/usr/bin/sigmaos-platform-imgui" 2>/dev/null || true
    install -Dm644 README.md "${pkgdir}/usr/share/doc/sigmaos-platform-imgui/README.md"
}
