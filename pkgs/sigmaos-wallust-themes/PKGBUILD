# Maintainer: Aaryan Singh Chauhan <aaryansinghchauhan@users.noreply.github.com>
pkgname=sigmaos-wallust-themes
pkgver=0.1.0
pkgrel=1
pkgdesc="16-color ANSI presets and templates for Wallust dynamic theming"
arch=('any')
url="https://github.com/AaryanSinghChauhan09/SigmaOS"
license=('MIT')
depends=('wallust')

package() {
    mkdir -p "$pkgdir/usr/share/sigmaos/wallust/presets"
    mkdir -p "$pkgdir/usr/share/sigmaos/wallust/templates"
    
    # Install SigmaOS default preset
    cat > "$pkgdir/usr/share/sigmaos/wallust/presets/sigmaos" <<'EOF'
[colors]
background = "#1a1b26"
foreground = "#c0caf5"

color0 = "#15161e"
color1 = "#f7768e"
color2 = "#9ece6a"
color3 = "#e0af68"
color4 = "#7aa2f7"
color5 = "#bb9af7"
color6 = "#7dcfff"
color7 = "#a9b1d6"

color8 = "#414868"
color9 = "#f7768e"
color10 = "#9ece6a"
color11 = "#e0af68"
color12 = "#7aa2f7"
color13 = "#bb9af7"
color14 = "#7dcfff"
color15 = "#c0caf5"
EOF
    
    # Install Hyprland template
    cat > "$pkgdir/usr/share/sigmaos/wallust/templates/hyprland.conf" <<'EOF'
{{background}}
$background = rgba({{rgb.background}},0.8)
{{foreground}}
$foreground = {{rgb.foreground}}
{{color0}}
$color0 = {{rgb.color0}}
{{color1}}
$color1 = {{rgb.color1}}
{{color2}}
$color2 = {{rgb.color2}}
{{color3}}
$color3 = {{rgb.color3}}
{{color4}}
$color4 = {{rgb.color4}}
{{color5}}
$color5 = {{rgb.color5}}
{{color6}}
$color6 = {{rgb.color6}}
{{color7}}
$color7 = {{rgb.color7}}
{{color8}}
$color8 = {{rgb.color8}}
{{color9}}
$color9 = {{rgb.color9}}
{{color10}}
$color10 = {{rgb.color10}}
{{color11}}
$color11 = {{rgb.color11}}
{{color12}}
$color12 = {{rgb.color12}}
{{color13}}
$color13 = {{rgb.color13}}
{{color14}}
$color14 = {{rgb.color14}}
{{color15}}
$color15 = {{rgb.color15}}
EOF
}
