# Maintainer: AaryanSinghChauhan09 <AaryanSinghChauhan09@users.noreply.github.com>
pkgname=sigmaos-onlyoffice-document
pkgver=0.1.0
pkgrel=1
pkgdesc="SigmaOS OnlyOffice Document DOCX editor"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/AaryanSinghChauhan09/SigmaOS-onlyoffice-document"
license=('GPL3')
makedepends=('rust' 'cargo')
groups=('sigmaos-onlyoffice')
source=("git+${url}.git#branch=main")
sha256sums=('SKIP')

build() {
    cd "SigmaOS-onlyoffice-document"
    cargo build --release --all
}

check() {
    cd "SigmaOS-onlyoffice-document"
    cargo test --all
}

package() {
    cd "SigmaOS-onlyoffice-document"
    install -Dm755 "target/release/sigmaos-onlyoffice-document" "${pkgdir}/usr/bin/sigmaos-onlyoffice-document" 2>/dev/null || true
    install -Dm644 README.md "${pkgdir}/usr/share/doc/sigmaos-onlyoffice-document/README.md"
}
