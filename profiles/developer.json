{
  "name": "developer",
  "description": "Low blur, dev tools, all build shards active",
  "sync_interval": 300,
  "shards": ["virtualization", "wasm", "sync", "automation"],
  "theme": "dark",
  "accent": "#00f0ff",
  "blur": 15,
  "font_scale": 0.95,
  "shortcuts": {
    "build": "Ctrl+B",
    "sync":  "Ctrl+S",
    "status":"Ctrl+T",
    "focus": "Ctrl+F"
  },
  "layout": {
    "dashboard_panels": ["shards", "sync", "status", "profiles"],
    "default_view": "shards"
  },
  "preferences": {
    "auto_sync":       true,
    "notifications":   true,
    "self_heal":       true,
    "privacy_shield":  false,
    "background_fx":   true
  }
}
