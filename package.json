{
  "name": "sigmaos-zenith",
  "version": "15.0.0",
  "description": "SigmaOS Zenith Desktop Environment",
  "type": "module",
  "main": "zenith_desktop/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint zenith_desktop --ext .js --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write zenith_desktop",
    "start": "electron .",
    "audit": "npm audit --audit-level=moderate"
  },
  "devDependencies": {
    "@vitest/ui": "3.2.0",
    "electron": "42.1.0",
    "eslint": "10.3.0",
    "eslint-plugin-security": "3.0.1",
    "jsdom": "29.1.1",
    "prettier": "3.5.3",
    "vite": "8.0.11",
    "vitest": "3.2.0"
  }
}
